        max-width: 65rem;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 0.6rem;
    }

    .comparison__table {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-left: 0.05rem solid #E3E3E3;
        border-right: 0.05rem solid #E3E3E3;
