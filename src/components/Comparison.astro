        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .comparison__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .comparison__eyebrow span {
        color: var(--color-accent);
    }

    .comparison__header-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: end;
        margin-bottom: 8rem;
    }

    .comparison__title {
        max-width: 62rem;
        color: #ffffff;
        font-size: clamp(3.8rem, 4.4vw, 4.2rem);
        margin: 0;
    }

