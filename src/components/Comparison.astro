---
import type { Language } from "../i18n";

const { lang = "en", t } = Astro.props as {
    lang: Language;
    t: (typeof import("../i18n").translations)["en"];
};
---

<section class="comparison">

    <div class="container">

        <img
            class="comparison__chandelier"
            src="/decorative/decoration_chandelier.webp"
            alt=""
            draggable="false"
        />

        <div class="comparison__eyebrow">
            <span>05</span>
            {t.comparisonEyebrow}
        </div>

        <div class="comparison__header-content">

            <h3 class="comparison__title">
                {t.comparisonTitle}
            </h3>

            <p class="comparison__description">
                {t.comparisonDescription}
            </p>

        </div>

        <div class="comparison__table">

            <div class="comparison__column comparison__column--direct">

                <h5 class="comparison__heading">
                    {t.comparisonDirectHeading}
                </h5>

                <ul class="comparison__list">

                    <li class="comparison__item">
                        <p>{t.comparisonDirectItem1}</p>
                    </li>

                    <li class="comparison__item">
                        <p>{t.comparisonDirectItem2}</p>
                    </li>

                    <li class="comparison__item">
                        <p>{t.comparisonDirectItem3}</p>
                    </li>

                    <li class="comparison__item">
                        <p>{t.comparisonDirectItem4}</p>
                    </li>

                </ul>

            </div>

            <div class="comparison__column comparison__column--woodara">

                <h5 class="comparison__heading">
                    {t.comparisonWoodaraHeading}
                </h5>

                <ul class="comparison__list">

                    <li class="comparison__item">
                        <p>{t.comparisonWoodaraItem1}</p>
                    </li>

                    <li class="comparison__item">
                        <p>{t.comparisonWoodaraItem2}</p>
                    </li>

                    <li class="comparison__item">
                        <p>{t.comparisonWoodaraItem3}</p>
                    </li>

                    <li class="comparison__item">
                        <p>{t.comparisonWoodaraItem4}</p>
                    </li>

                </ul>

            </div>

        </div>

    </div>

</section>

<style>
    .comparison {
        background-color: #111111;
        padding: 10rem 0;
        position: relative;
        overflow: hidden;
    }
    

    .comparison .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .comparison__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-display);
        color: #E3E3E3;
        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .comparison__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .comparison__eyebrow span {
        color: var(--color-accent);
    }

    .comparison__header-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: end;
        margin-bottom: 8rem;
    }

    .comparison__title {
        max-width: 62rem;
        color: #ffffff;
        font-size: clamp(3.8rem, 4.4vw, 4.2rem);
        margin: 0;
    }

    .comparison__description {
        max-width: 65rem;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 0.6rem;
    }

    .comparison__table {
        display: grid;
        grid-template-columns: 1fr 1fr;
        border-left: 0.05rem solid #E3E3E3;
        border-right: 0.05rem solid #E3E3E3;
        padding: 0 8rem;
        
    }

    .comparison__column {
        min-width: 0;
        padding-top: 4rem;
        padding-bottom: 2rem;
    }

    .comparison__column--direct {
        padding-right: 8rem;
    }

    .comparison__column--woodara {
        padding-left: 6rem;
    }

    .comparison__heading {
        display: inline-block;
        color: #E3E3E3;
        text-transform: uppercase;
        margin-bottom: 5rem;
        padding-bottom: 2rem;
        border-bottom: 0.05rem solid #E3E3E3;
    }

    .comparison__list {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .comparison__item {
        position: relative;
        height: 8.2rem;
        box-sizing: border-box;
        margin: 0;
        padding: 3rem 0 3rem 2.4rem;
        border-bottom: 0.05rem solid #E3E3E3;
        display: flex;
        align-items: center;
    }

    .comparison__item::before {
        content: "•";
        position: absolute;
        left: 0;
        top: 3rem;
        font-size: 1.6rem;
    }

    .comparison__column--direct .comparison__item::before {
        color: #FF3B30;
        text-shadow: 0 0 0.8rem rgba(255, 59, 48, 0.8);
    }

    .comparison__column--woodara .comparison__item::before {
        color: #2E8A3A;
        text-shadow: 0 0 0.8rem rgba(46, 138, 58, 0.8);
    }

    .comparison__item p {
        max-width: 52rem;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .comparison__item:last-child {
        border-bottom: none;
    }

    .comparison__chandelier {
        position: absolute;
        width: 65rem;
        left: calc(50% + 2rem);
        top: -26rem;
        z-index: 10;
        pointer-events: none;
    }

    @media (max-width: 1024px) {

        .comparison__table {
            padding: 0 5rem;
        }

        .comparison__chandelier {
            display: none;
        }
    }

    @media (max-width: 768px) {

        .comparison {
            padding: 6rem 0;
        }

        .comparison__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .comparison__header-content {
            display: flex;
            flex-direction: column;
            gap: 0;
            align-items: stretch;
            margin-bottom: 5rem;
        }

        .comparison__title {
            max-width: 100%;
            font-size: 3.2rem;
            margin-bottom: 3rem;
        }

        .comparison__description {
            max-width: 100%;
            font-size: 1.4rem;
            margin: 0;
        }

        .comparison__table {
            display: flex;
            flex-direction: column;
            gap: 1.4rem;
            border: none;
            padding: 0;
        }

        .comparison__column {
            padding: 2.4rem 2.4rem;
            border: 0.05rem solid #E3E3E3;
        }

        .comparison__column--direct,
        .comparison__column--woodara {
            padding-left: 2.4rem;
            padding-right: 2.4rem;
        }

        .comparison__heading {
            margin: 1rem 0 0;
            padding-bottom: 0.rem;
            border-bottom: none;
        }

        .comparison__item {
            height: auto;
            padding: 1.8rem 0 1.8rem 2.4rem;
            align-items: flex-start;
        }

        .comparison__item::before {
            left: 0;
            top: 2rem;
            font-size: 1.4rem;
        }

        .comparison__item p {
            max-width: 100%;
            font-size: 1.4rem;
            line-height: 1.4;
            margin: 0;
        }

        .comparison__chandelier {
            display: none;
        }

    }


</style>