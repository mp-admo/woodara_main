                    <img src="/logo_woodara_footer.svg" alt="Woodara">
                </a>

                <div class="footer__address">
                    <p>PT Woodara Projects Supplier</p>
                    <p>Jalan Mertanadi No. 31, Kuta Utara, Badung, Bali 80363</p>
                </div>

            </div>


            <nav class="footer__nav">

                <div class="footer__links">
                    <a href="#">Projects</a>
                    <a href="#">Why Woodara</a>
                    <a href="#">Process</a>
                    <a href="#">FAQ</a>
                </div>

                <div class="footer__contacts">
                    <a href="tel:+6282145208372">
                        +62 821 4520 8372
                    </a>

                    <a href="mailto:woodara.shop@gmail.com">
