<style>

    .footer {
        background-color: #111111;
        padding-top: 10rem
    }

    .footer .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .footer__top {
        display: grid;
        grid-template-columns: 60% 40%;
        gap: 0;
        padding-bottom: 8rem;
    }

    .footer__brand {
        min-width: 0;
    }

    .footer .logo {
        display: inline-block;
        margin-bottom: 3rem;
    }

    .footer .logo img {
        display: block;
        width: 18rem;
        height: auto;
    }

    .footer__address {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .footer__address p {
        font-family: 'Outfit';
        letter-spacing: -0.03em;
        color: #E3E3E3;
        font-size: 1.8rem;
        line-height: 1.2;
    }

    .footer__nav {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
    }

    .footer__links,
    .footer__contacts {
        display: flex;
        flex-direction: column;
        gap: 2rem;
    }

    .footer__nav a {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        line-height: 1.1;
        letter-spacing: -0.03em;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .footer__nav a:hover {
        color: var(--color-accent);
    }

    .footer__bottom {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 3rem 0;
        border-top: 0.05rem solid #888888;
    }

    .footer__bottom p {
        font-family: 'Outfit';
        letter-spacing: -0.03em;
        color: #E3E3E3;
        font-size: 1.8rem;
        line-height: 1.1;
    }

    .footer__designer {
        text-align: right;
    }


    @media (max-width: 1024px) {

        .footer__top {
            grid-template-columns: 50% 50%;
        }
    }

    @media (max-width: 768px) {

        .footer {
            padding-top: 6rem;
        }

        .footer__top {
            grid-template-columns: 1fr;
            padding-bottom: 5rem;
        }

        .footer__brand {
            margin-bottom: 5rem;
        }

        .footer .logo {
            margin-bottom: 3rem;
        }

        .footer .logo img {
            width: 16rem;
        }

        .footer__address {
            gap: 0.8rem;
        }

        .footer__address p {
            font-size: 1.4rem;
            line-height: 1.1;
        }

        .footer__nav {
            display: flex;
            flex-direction: column;
            gap: 5rem;
        }

        .footer__links,
        .footer__contacts {
            gap: 1.8rem;
        }

        .footer__nav a {
            font-size: 1.6rem;
        }

        .footer__nav a:hover {
            color: #E3E3E3;
        }

        .footer__bottom {
            flex-direction: column;
            align-items: flex-start;
            gap: 1.4rem;
            padding: 2rem 0;
        }

        .footer__bottom p {
            font-size: 1.4rem;
        }

        .footer__designer {
            text-align: left;
        }

    }

</style>