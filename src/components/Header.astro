---
import type { Language } from "../i18n";

const { lang = "en", t } = Astro.props as {
    lang: Language;
    t: (typeof import("../i18n").translations)["en"];
};

// Same page in the other language: strip the current language prefix from the path
const pagePath = Astro.url.pathname.replace(new RegExp(`^/${lang}(?=/|$)`), "") || "/";
---

<header class="header">

    <nav class="header__nav">

        <a href={`/${lang}/`} class="logo">
            <img src="/logo_woodara.svg" alt="Woodara">
        </a>

        <div class="header__menu">

            <a href="#categories" class="header__menu-link">
                {t.headerCategories}
            </a>

            <a href="#projects" class="header__menu-link">
                {t.headerProjects}
            </a>

            <a href="#scope" class="header__menu-link">
                {t.headerScope}
            </a>

            <a href="#process" class="header__menu-link">
                {t.headerProcess}
            </a>

            <a href="#contact" class="header__menu-link">
                {t.headerContact}
            </a>

            <a href="#" class="header__menu-link">
                {t.headerAboutus}
            </a>

        </div>

        <div class="header__actions">

            <div class="language-switcher">

                <button
                    class="language-switcher__button"
                    aria-label={t.headerLanguageLabel}
                    aria-expanded="false"
                    type="button"
                >
                    <img
                        class="language-switcher__current-flag"
                        src={lang === "en" ? "/flags/united-kingdom.png" : "/flags/Indonesia.png"}
                        alt=""
                    />
                </button>

                <div class="language-switcher__dropdown">

                    <a href={`/en${pagePath}`} aria-label="English" aria-current={lang === "en" ? "true" : undefined}>
                        <img src="/flags/united-kingdom.png" alt="" />
                    </a>

                    <a href={`/id${pagePath}`} aria-label="Bahasa Indonesia" aria-current={lang === "id" ? "true" : undefined}>
                        <img src="/flags/Indonesia.png" alt="" />
                    </a>

                </div>

            </div>

            <a href="#contact" class="header__button">
                {t.headerButton}
            </a>

        </div>

        <button class="burger-button" aria-label={t.headerMenuLabel}>
            <span></span>
            <span></span>
            <span></span>
        </button>

    </nav>

</header>

<div class="mobile-menu">

    <nav class="mobile-menu__nav">

        <a href="#categories" class="mobile-menu__link">
            {t.headerCategories}
        </a>

        <a href="#projects" class="mobile-menu__link">
            {t.headerProjects}
        </a>

        <a href="#scope" class="mobile-menu__link">
            {t.headerScope}
        </a>

        <a href="#process" class="mobile-menu__link">
            {t.headerProcess}
        </a>

        <a href="#contact" class="mobile-menu__link">
            {t.headerContact}
        </a>

        <a href="#" class="mobile-menu__link">
            {t.headerAboutus}
        </a>

    </nav>

     <a href="#contact" class="mobile-menu__button">
        {t.headerButton}
    </a>

</div>


<style>
    .header {
        width: 100%;
        height: 6.2rem;
        background-color: #F4F3F0;
        border-bottom: 0.05rem solid #888888;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .header__nav {
        width: 100%;
        max-width: 140rem;
        height: 100%;
        padding: 0 2rem;
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .logo {
        display: block;
        flex-shrink: 0;
    }

    .logo img {
        display: block;
        width: auto;
        height: 2rem;
    }

    .header__menu {
        display: flex;
        align-items: center;
        gap: 2.8rem;
    }

    .header__menu-link {
        font-family: 'Outfit', sans-serif;
        font-size: 1.7rem;
        letter-spacing: -0.03em;
        color: #151516;
        text-decoration: none;
        line-height: 1;
        transition: color 0.3s ease;
        font-weight: 400;
    }

    .header__menu-link:hover {
        color: var(--color-accent);
    }

    .header__actions {
        display: flex;
        align-items: center;
        gap: 2rem;
        flex-shrink: 0;
    }

    .header__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Outfit', sans-serif;
        letter-spacing: -0.03em;
        padding: 1rem 2rem;
        font-weight: 400;
        border: 0.1rem solid #888888;
        background-color: transparent;
        color: #151516;
        text-decoration: none;
        cursor: pointer;
        transition: background-color 0.5s ease;
    }

    .header__button:hover {
        background-color: #151516;
        color: #fff;
    }

    /* Language switcher */

    .language-switcher {
        position: relative;
        flex-shrink: 0;
    }

    .language-switcher__button {
        display: flex;
        align-items: center;
        justify-content: center;

        padding: 0;
        border: none;
        background: transparent;

        cursor: pointer;
    }

    .language-switcher__current-flag {
        display: block;
        width: 3.6rem;
        height: 2.6rem;
        object-fit: contain;
    }

    .language-switcher__dropdown {
        position: absolute;
        top: calc(100% + 1rem);
        right: 0;

        display: flex;
        flex-direction: column;

        min-width: 7rem;
        padding: 0.5rem 0;

        background: #fff;
        box-shadow: 0 0.4rem 1.5rem rgba(0, 0, 0, 0.12);

        opacity: 0;
        visibility: hidden;
        transform: translateY(-0.5rem);

        transition: 0.2s ease;
        z-index: 300;
    }

    .language-switcher.is-open .language-switcher__dropdown {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .language-switcher__dropdown a {
        display: flex;
        align-items: center;
        justify-content: center;

        padding: 1rem 1.5rem;

        text-decoration: none;
        cursor: pointer;

        transition: background-color 0.2s ease;
    }

    .language-switcher__dropdown a:hover {
        background-color: #f2f2f2;
    }

    .language-switcher__dropdown img {
        display: block;
        width: 3.2rem;
        height: 2.2rem;
        object-fit: contain;
    }

    .language-switcher__current-flag,
    .language-switcher__dropdown img {
        transition: transform 0.2s ease;
    }

    .language-switcher__button:hover .language-switcher__current-flag,
    .language-switcher__dropdown a:hover img {
        transform: translateY(-1px);
    }

    /* Burger button */

    .burger-button {
        display: none;
    }

    /* Mobile menu */

    .mobile-menu {
        position: fixed;
        top: 6.2rem;
        left: 0;
        width: 100%;
        height: calc(100vh - 6.2rem);
        background-color: #F4F3F0;
        padding: 2rem;
        display: flex;
        flex-direction: column;
        opacity: 0;
        visibility: hidden;
        transition: 0.3s ease;
        z-index: 200;
        gap: 8rem;
    }

    .mobile-menu.is-open {
        opacity: 1;
        visibility: visible;
    }

    .mobile-menu__close span {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 2rem;
        height: 0.1rem;
        background-color: #151516;
    }

    .mobile-menu__close span:first-child {
        transform: translate(-50%, -50%) rotate(45deg);
    }

    .mobile-menu__close span:last-child {
        transform: translate(-50%, -50%) rotate(-45deg);
    }

    .mobile-menu__nav {
        display: flex;
        flex-direction: column;
        gap: 2.6rem;
        margin-top: 5rem;
    }

    .mobile-menu__link {
        font-family: 'Outfit', sans-serif;
        font-size: 2.4rem;
        letter-spacing: -0.03em;
        color: #151516;
        text-decoration: none;
    }

    .mobile-menu__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;

        font-family: "Outfit", sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        padding: 1.5rem 2.7rem;

        border: 0.1rem solid #888888;
        background-color: #151516;
        color: #fff;
        text-decoration: none;
    }

    @media (max-width: 768px) {
        .header__menu,
        .header__button {
            display: none;
        }

        .header__actions {
            display: flex;
            align-items: center;
            gap: 0;
            margin-left: auto;
            margin-right: 2rem;
        }

        .header__nav {
            justify-content: space-between;
        }

        .burger-button {
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: flex-end;

            gap: 0.4rem;

            width: 2.4rem;
            height: 2.4rem;

            padding: 0;
            border: none;
            background: transparent;

            cursor: pointer;
            overflow: hidden;
        }

        .burger-button span {
            display: block;

            width: 2.4rem;
            height: 0.2rem;

            margin: 0;

            background-color: #151516;

            transition:
                transform 0.3s ease,
                opacity 0.3s ease;
        }

        .burger-button--active span:nth-child(1) {
            transform: translateY(0.6rem) rotate(45deg);
        }

        .burger-button--active span:nth-child(2) {
            opacity: 0;
        }

        .burger-button--active span:nth-child(3) {
            transform: translateY(-0.6rem) rotate(-45deg);
        }
    }
</style>


<script>

    const burgerBtn = document.querySelector('.burger-button');
    const mobileMenu = document.querySelector('.mobile-menu');
    const menuLinks = document.querySelectorAll('.mobile-menu__link, .mobile-menu__button');

    if (burgerBtn && mobileMenu) {

        burgerBtn.addEventListener('click', () => {

            mobileMenu.classList.toggle('is-open');
            burgerBtn.classList.toggle('burger-button--active');

            if (mobileMenu.classList.contains('is-open')) {
                document.body.style.overflow = 'hidden';
            } else {
                document.body.style.overflow = '';
            }

        });

        menuLinks.forEach(link => {

            link.addEventListener('click', () => {

                mobileMenu.classList.remove('is-open');
                burgerBtn.classList.remove('burger-button--active');
                document.body.style.overflow = '';

            });

        });

    }

    const languageSwitcher = document.querySelector(".language-switcher");
    const languageButton = document.querySelector(".language-switcher__button");

    if (languageSwitcher && languageButton) {
        languageButton.addEventListener("click", (event) => {
            event.stopPropagation();

            const isOpen = languageSwitcher.classList.toggle("is-open");

            languageButton.setAttribute("aria-expanded", String(isOpen));
        });

        document.addEventListener("click", (event) => {
            if (!(event.target instanceof Node) || !languageSwitcher.contains(event.target)) {
                languageSwitcher.classList.remove("is-open");
                languageButton.setAttribute("aria-expanded", "false");
            }
        });
    }

    // Keep query string (UTM) and hash when switching language
    const languageLinks = document.querySelectorAll<HTMLAnchorElement>(".language-switcher__dropdown a");

    languageLinks.forEach((link) => {
        link.addEventListener("click", () => {
            const url = new URL(link.href);

            url.search = window.location.search;
            url.hash = window.location.hash;

            link.href = url.toString();
        });
    });

</script>

