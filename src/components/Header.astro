---

<header class="header">

    <nav class="header__nav">

        <a href="/" class="logo">
            <img src="/logo_woodara.svg" alt="Woodara">
        </a>

        <div class="header__menu">

            <a href="#categories" class="header__menu-link">
                Product categories
            </a>

            <a href="#projects" class="header__menu-link">
                Projects
            </a>

            <a href="#about" class="header__menu-link">
                Why Woodara
            </a>

            <a href="#scope" class="header__menu-link">
                Scope
            </a>

            <a href="#proof" class="header__menu-link">
                Proof
            </a>

            <a href="#process" class="header__menu-link">
                Process
            </a>

            <a href="#faq" class="header__menu-link">
                FAQ
            </a>

        </div>

        <button class="header__button" type="button">
            Get a project review
        </button>

    </nav>

</header>

<style>

    .header {
        width: 100%;
        height: 6.2rem;
        background-color: #F4F3F0;
        border-bottom: 0.05rem solid #888888;
        position: sticky;
        top: 0;
        z-index: 100;
    }

    .header__nav {
        width: 100%;
        max-width: 140rem;
        height: 100%;
        padding: 0 2rem;
        margin: 0 auto;

        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .header__logo {
        display: block;
        flex-shrink: 0;
    }

    .header__logo img {
        display: block;
        width: auto;
        height: 2rem;
    }

    .header__menu {
        display: flex;
        align-items: center;
        gap: 2.8rem;
    }

    .header__menu-link {
        font-family: 'Outfit', sans-serif;
        font-size: 1.7rem;
        letter-spacing: -0.03em;
        color: #151516;
        text-decoration: none;
        line-height: 1;
        transition: color 0.3s ease;
    }

    .header__menu-link:hover {
        color: #888;
    }

    .header__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Outfit', sans-serif;
        letter-spacing: -0.03em;
        padding: 1rem 2rem;

        border: 0.1rem solid #888888;
        background-color: transparent;
        color: #151516;
        text-decoration: none;
        cursor: pointer;

        transition: background-color 0.5s ease;
    }

    .header__button:hover {
        background-color: #151516;
        color: #fff;
    }

</style>