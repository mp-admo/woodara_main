---
import type { Language } from "../i18n";

const { lang = "en", t } = Astro.props as {
    lang: Language;
    t: (typeof import("../i18n").translations)["en"];
};
---

<section class="volume">

    <div class="container">

        <div class="volume__grid">

            <div class="volume__content">

                <div class="volume__eyebrow">
                    <span>06</span>
                    {t.volumeEyebrow}
                </div>

                <h2 class="volume__title">
                    {t.volumeTitle}
                </h2>

                <div class="volume__text">

                    <p>
                        {t.volumeText1}
                    </p>

                    <p>
                        {t.volumeText2}
                    </p>

                </div>

            </div>

            <div class="volume__stat">

                <div class="volume__number">12</div>

                <div class="volume__label">
                    {t.volumeLabelLine1}<br />{t.volumeLabelLine2}
                </div>

            </div>

        </div>

    </div>

</section>

<style>

    .volume {
        background-color: #F4F3F0;
        border-bottom: 0.05rem solid #888888;
    }

    .volume .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }


    .volume__grid {
        display: grid;
        grid-template-columns: 65.5% 35.5%;
        align-items: stretch;
    }

    .volume__content {
        padding: 10rem 10rem 10rem 0;
    }

    .volume__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-display);
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .volume__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .volume__eyebrow span {
        color: var(--color-accent);
    }

    .volume__title {
        max-width: 80rem;
        color: #151516;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
        margin-bottom: 4rem;
    }

    .volume__text {
        max-width: 90rem;
    }

    .volume__text p {
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 2rem;
    }

    .volume__text p:last-child {
        margin-bottom: 0;
    }

    .volume__stat {
        border-left: 0.05rem solid #888888;
        padding-left: 8rem;
        display: flex;
        flex-direction: column;
        padding-top: 17rem;
    }

    .volume__number {
        color: #151516;
        font-size: clamp(10rem, 11vw, 12.8rem);
        font-family: var(--font-display);
        line-height: 1.1;
    }

    .volume__label {
        color: #58585A;
        font-family: var(--font-display);
        letter-spacing: -0.03em;
        font-size: 1.6rem;
        line-height: 1.4;
        text-transform: uppercase;
    }

    @media (max-width: 768px) {

        .volume__grid {
            grid-template-columns: 1fr;
        }

        .volume__content {
            padding: 6rem 0 0;
        }

        .volume__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .volume__title {
            max-width: 100%;
            font-size: 3.6rem;
            margin-bottom: 3rem;
        }

        .volume__text {
            max-width: 100%;
        }

        .volume__text p {
            font-size: 1.4rem;
            margin-bottom: 1rem;
        }

        .volume__stat {
            border-left: none;
            border-top: 0.05rem solid #888888;
            padding: 3rem 0 6rem;
            margin-top: 3.6rem;
        }

        .volume__number {
            font-size: 8rem;
            line-height: 1;
        }

        .volume__label {
            font-size: 1.3rem;
        }

    }

    @media (max-width: 1024px) {

        .volume__number {
            font-size: 8rem;
        }
    }

</style>