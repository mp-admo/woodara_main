<style>

    .showcase {
        background-color: #F4F3F0;
    }

    .container {
        width: 100%;
        max-width: 140rem; 
        padding: 0 2rem;
        margin: 0 auto;
        border-left: 0.05rem solid #888888;
        border-right: 0.05rem solid #888888;
    }

    .showcase__metrics {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

    .showcase__metric {
        display: flex;
        flex-direction: column;
        padding: 4rem;
        border-left: 0.05rem solid #888888;
        gap: 1.2rem;
    }

    .showcase__metric:first-child {
        border-left: none;
    }

    .showcase__metric-value {
        color: #151516;
    }

    .showcase__metric-label {
        color: #58585A;
        font-size: 1.4rem;
    }

    .showcase__ticker-wrapper {
        background-color: #F4F3F0;
        border-bottom: 0.05rem solid #888888;
        border-top: 0.05rem solid #888888;
    }

    .showcase__ticker-wrapper .container {
        padding: 0;
    }

    .showcase__ticker {
        overflow: hidden;
    }

    .showcase__ticker-track {
        display: flex;
        align-items: center;
        width: max-content;
        padding: 1.6rem 0;
    }

    .showcase__ticker-item {
        font-family: 'Poppins', sans-serif;
        color: #151516;
        font-size: 1rem;
        line-height: 1;
        letter-spacing: 0.26rem;
        text-transform: uppercase;
        padding: 0 4rem;
        border-right: 0.05rem solid #888888;
        white-space: nowrap;
    }

    .showcase__ticker-item:first-child {
        border-left: 0.05rem solid #888888;
    }

    .showcase__ticker-track {
        animation: ticker-scroll 40s linear infinite;
    }

    @keyframes ticker-scroll {

        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }

    }

    @media (max-width: 768px) {


        .showcase__metrics {
            grid-template-columns: repeat(2, 1fr);
            margin-left: -2rem;
            margin-right: -2rem;
        }

        .showcase__metric {
            padding: 4rem 2rem; 
            border-left: none; 
            border-bottom: 0.1rem solid rgba(255, 255, 255, 0.1);
        }

        .showcase__metric:nth-child(even) {
            border-left: 0.1rem solid rgba(255, 255, 255, 0.1);
        }

        .showcase__metric:nth-last-child(-n+2) {
            border-bottom: none;
        }

        .showcase__metric-value {
            font-size: 3.6rem; 
        }

        .showcase__metric-label {
            font-size: 1rem;
            line-height: 1.3;
        }
    }
    
</style>