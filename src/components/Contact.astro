---

<section class="contact">

    <div class="container">

        <div class="contact__grid">

            <div class="contact__left">

                <div class="contact__eyebrow">
                    <span>11</span>
                    Start here
                </div>

                <h2 class="contact__title">
                    Tell us what you're building
                </h2>

                <div class="contact__person">

                    <div class="contact__person-image">
                        <img src="/roman_minaev.png" alt="">
                    </div>

                    <div class="contact__person-info">
                        <p class="contact__person-name">
                            Roman Minaev
                        </p>

                        <p class="contact__person-role">
                            Founder of Woodara
                        </p>
                    </div>

                </div>

            </div>


            <div class="contact__right">

                <p class="contact__intro">
                    Send a spec, a render, or just a rough scope.<br>
                    You'll get a comparative read on cost and timeline before you commit to anything.
                </p>

                <form class="contact__form">

                    <div class="contact__field">
                        <label for="name">
                            Your name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                        >
                    </div>


                    <div class="contact__field">
                        <label for="company">
                            Company
                        </label>

                        <span class="contact__optional">
                            optional
                        </span>

                        <input
                            type="text"
                            id="company"
                            name="company"
                        >
                    </div>


                    <div class="contact__field">
                        <label for="phone">
                            Phone number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="+"
                        >
                    </div>

                    <div class="contact__field contact__telegram-field" hidden>

                        <label for="telegram">
                            Telegram link
                        </label>

                        <input
                            type="text"
                            id="telegram"
                            name="telegram"
                            value="@"
                        >

                    </div>


                    <div class="contact__channels">

                        <p class="contact__channels-title">
                            Convenient communication format
                        </p>

                        <div class="contact__buttons">

                            <button
                                type="button"
                                class="contact__channel is-active"
                            >
                                Call
                            </button>

                            <button
                                type="button"
                                class="contact__channel"
                            >
                                WhatsApp
                            </button>

                            <button
                                type="button"
                                class="contact__channel"
                            >
                                Telegram
                            </button>

                        </div>

                    </div>


                    <button
                        type="submit"
                        class="contact__submit"
                    >
                        Leave a request
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>

<style>

    .contact {
        background-color: #111111;
        padding: 10rem 0;
        border-bottom: 0.05rem solid #E3E3E3;
    }

    .contact .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .contact__grid {
        display: grid;
        grid-template-columns: 50% 50%;
        gap: 0;
    }

    .contact__left {
        min-width: 0;
        padding-right: 8rem;
    }

    .contact__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 6rem;
        color: #E3E3E3;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.6rem;
        line-height: 1;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
    }

    .contact__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .contact__eyebrow span {
        color: #2E7C77;
    }

    .contact__title {
        max-width: 65rem;
        color: #fff;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .contact__person {
        display: flex;
        align-items: center;
        gap: 3rem;
        margin-top: 10rem;
    }

    .contact__person-image {
        width: 15.2rem;
        height: 15.2rem;
        flex-shrink: 0;
        overflow: hidden;
    }

    .contact__person-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .contact__person-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .contact__person-name {
        font-family: 'Poppins';
        letter-spacing: -0.03rem;
        color: #fff;
        font-size: 2rem;
        line-height: 1.2;
    }

    .contact__person-role {
        color: #E3E3E3;
        font-size: 1.4rem;
        line-height: 1.2;
    }

    .contact__right {
        min-width: 0;
        padding: 9rem 0 0 4rem;

    }

    .contact__intro {
        max-width: 45rem;
        margin-bottom: 10rem;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .contact__form {
        width: 100%;
        max-width: 60rem;
    }

    .contact__field {
        position: relative;
        margin-bottom: 4rem;
    }

    .contact__field label {
        position: absolute;
        top: -0.9rem;
        left: 2rem;
        padding: 0 1rem;
        background-color: #111111;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1;
        font-family: 'Poppins';
        letter-spacing: -0.03rem;
        transition: color 0.2s ease;
    }

    .contact__field input {
        width: 100%;
        height: 5.8rem;
        padding: 0 2rem;
        border: 0.05rem solid #888888;
        border-radius: 0.5rem;
        outline: none;
        background: transparent;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 1.6rem;
        transition: border-color 0.2s ease;
    }

    .contact__field:hover label,
    .contact__field:focus-within label {
        color: #fff;
    }

    .contact__field:hover input,
    .contact__field:focus-within input {
        border-color: #fff;
    }

    .contact__field input:focus {
        border-color: #E3E3E3;
    }

    .contact__optional {
        position: absolute;
        top: 50%;
        right: 2rem;
        transform: translateY(-50%);
        color: #E3E3E3;
        font-size: 1.5rem;
    }

    .contact__channels {
        margin-top: 1rem;
    }

    .contact__channels-title {
        margin: 0 0 2rem;
        color: #E3E3E3;
        font-size: 1.5rem;
    }

    .contact__buttons {
        display: flex;
        gap: 1rem;
    }

    .contact__channel {
        padding: 1rem 2rem;
        border: 0.05rem solid #888888;
        border-radius: 0.3rem;
        background: transparent;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        cursor: pointer;
    }

    .contact__channel.is-active {
        border-color: #fff;
        background-color: #fff;
        color: #111111;
    }

    .contact__submit {
        margin-top: 4rem;
        padding: 1.3rem 2.4rem;
        border: 0.05rem solid #fff;
        background-color: #fff;
        color: #111111;
        font-family: 'Poppins', sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        cursor: pointer;
        transition: 0.3s ease;
    }

    .contact__submit:hover {
        transform: translateY(-2px);
    }

</style>

<script>
    const channelButtons = document.querySelectorAll('.contact__channel');
    const telegramField = document.querySelector('.contact__telegram-field') as HTMLElement;

    channelButtons.forEach((button) => {
        button.addEventListener('click', () => {

            channelButtons.forEach((item) => {
                item.classList.remove('is-active');
            });

            button.classList.add('is-active');

            if (button.textContent?.trim() === 'Telegram') {
                telegramField.hidden = false;
            } else {
                telegramField.hidden = true;
            }
        });
    });
</script>