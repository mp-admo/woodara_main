---

<section class="contact" id="contact">

    <div class="container">

        <div class="contact__grid">

            <div class="contact__left">

                <div class="contact__eyebrow">
                    <span>11</span>
                    Start here
                </div>

                <h2 class="contact__title">
                    Tell us what you're building
                </h2>

                <div class="contact__person">

                    <div class="contact__person-image">
                        <img src="/roman_minaev_contact.webp" alt="">
                    </div>

                    <div class="contact__person-info">
                        <p class="contact__person-name">
                            Roman Minaev
                        </p>

                        <p class="contact__person-role">
                            Founder of Woodara
                        </p>
                    </div>

                </div>

            </div>


            <div class="contact__right">

                <p class="contact__intro">
                    Send a spec, a render, or just a rough scope.<br>
                    You'll get a comparative read on cost and timeline before you commit to anything.
                </p>

                <form class="contact__form">

                    <div class="contact__field">
                        <label for="name">
                            Your name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                        >
                    </div>


                    <div class="contact__field">
                        <label for="company">
                            Company
                        </label>

                        <span class="contact__optional">
                            optional
                        </span>

                        <input
                            type="text"
                            id="company"
                            name="company"
                        >
                    </div>


                    <div class="contact__field">
                        <label for="phone">
                            Phone number
                        </label>

                        <input
                            type="tel"
                            id="phone"
                            name="phone"
                            value="+"
                        >
                    </div>

                    <div class="contact__field contact__telegram-field" hidden>

                        <label for="telegram">
                            Telegram link
                        </label>

                        <input
                            type="text"
                            id="telegram"
                            name="telegram"
                            value="@"
                        >

                    </div>


                    <div class="contact__channels">

                        <p class="contact__channels-title">
                            Convenient communication format
                        </p>

                        <div class="contact__buttons">

                            <button
                                type="button"
                                class="contact__channel is-active"
                            >
                                Call
                            </button>

                            <button
                                type="button"
                                class="contact__channel"
                            >
                                WhatsApp
                            </button>

                            <button
                                type="button"
                                class="contact__channel"
                            >
                                Telegram
                            </button>

                        </div>

                    </div>


                    <button
                        type="submit"
                        class="contact__submit"
                    >
                        Leave a request
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>

<style>

    .contact {
        background-color: #111111;
        padding: 10rem 0;
        border-bottom: 0.05rem solid #E3E3E3;
    }

    .contact .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .contact__grid {
        display: grid;
        grid-template-columns: 50% 50%;
        gap: 0;
    }

    .contact__left {
        min-width: 0;
        padding-right: 8rem;
    }

    .contact__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 6rem;
        color: #E3E3E3;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.6rem;
        line-height: 1;
        letter-spacing: -0.03em;
        text-transform: uppercase;
    }

    .contact__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .contact__eyebrow span {
        color: var(--color-accent);
    }

    .contact__title {
        max-width: 65rem;
        color: #fff;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .contact__person {
        display: flex;
        align-items: center;
        gap: 3rem;
        margin-top: 10rem;
    }

    .contact__person-image {
        width: 15.2rem;
        height: 15.2rem;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 50%;
    }

    .contact__person-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .contact__person-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .contact__person-name {
        font-family: 'Outfit';
        letter-spacing: -0.03em;
        color: #fff;
        font-size: 2.2rem;
        line-height: 1.2;
    }

    .contact__person-role {
        font-family: 'Outfit';
        letter-spacing: -0.03em;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.2;
    }

    .contact__right {
        min-width: 0;
        padding: 9rem 0 0 4rem;

    }

    .contact__intro {
        max-width: 45rem;
        margin-bottom: 10rem;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .contact__form {
        width: 100%;
        max-width: 60rem;
    }

    .contact__field {
        position: relative;
        margin-bottom: 4rem;
    }

    .contact__field label {
        position: absolute;
        top: -0.9rem;
        left: 2rem;
        padding: 0 1rem;
        background-color: #111111;
        color: #E3E3E3;
        font-size: 1.8rem;
        line-height: 1;
        font-family: 'Outfit';
        letter-spacing: -0.03em;
        transition: color 0.2s ease;
    }

    .contact__field input {
        width: 100%;
        height: 5.8rem;
        padding: 0 2rem;
        border: 0.05rem solid #888888;
        border-radius: 0.5rem;
        outline: none;
        background: transparent;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        letter-spacing: -0.03em;
        font-size: 1.8rem;
        transition: border-color 0.2s ease;
    }

    .contact__field:hover label,
    .contact__field:focus-within label {
        color: #fff;
    }

    .contact__field:hover input,
    .contact__field:focus-within input {
        border-color: #fff;
    }

    .contact__field input:focus {
        border-color: #E3E3E3;
    }

    .contact__optional {
        font-family: 'Outfit', sans-serif;
        letter-spacing: -0.03em;
        position: absolute;
        top: 50%;
        right: 2rem;
        transform: translateY(-50%);
        color: #E3E3E3;
        font-size: 1.6rem;
    }

    .contact__channels {
        margin-top: 1rem;
    }

    .contact__channels-title {
        margin: 0 0 2rem;
        color: #E3E3E3;
        font-size: 1.5rem;
    }

    .contact__buttons {
        font-weight: 400;
        display: flex;
        gap: 1rem;
    }

    .contact__channel {
        padding: 1.2rem 2.2rem;
        border: 0.05rem solid #888888;
        border-radius: 0.3rem;
        background: transparent;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        cursor: pointer;
    }

    .contact__channel.is-active {
        border-color: #fff;
        background-color: #fff;
        color: #111111;
    }

    .contact__submit {
        margin-top: 4rem;
        padding: 1.5rem 2.7rem;
        background-color: #fff;
        color: #111111;
        border: none;
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        cursor: pointer;
        transition: 0.3s ease;
        font-weight: 400;
    }

    .contact__submit:hover {
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {

        .contact {
            padding: 6rem 0;
        }

        .contact__grid {
            grid-template-columns: 1fr;
        }

        .contact__left {
            padding-right: 0;
        }

        .contact__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .contact__title {
            max-width: 100%;
            margin-bottom: 5rem;
            font-size: 3.6rem;
        }

        .contact__person {
            margin-top: 0;
            margin-bottom: 5rem;
            gap: 2rem;
        }

        .contact__person-image {
            width: 9rem;
            height: 9rem;
        }

        .contact__person-info {
            gap: 0.6rem;
        }

        .contact__person-name {
            font-size: 1.8rem;
        }

        .contact__person-role {
            font-size: 1.4rem;
        }

        .contact__right {
            padding: 0;
        }

        .contact__intro {
            max-width: 100%;
            margin-bottom: 5rem;
            font-size: 1.4rem;
        }

        .contact__form {
            max-width: 100%;
        }

        .contact__field {
            margin-bottom: 3rem;
        }

        .contact__field label {
            left: 1.6rem;
            font-size: 1.6rem;
        }

        .contact__field input {
            height: 5.6rem;
            padding: 0 1.6rem;
            font-size: 1.6rem;
        }

        .contact__optional {
            right: 1.6rem;
            font-size: 1.4rem;
        }

        .contact__channels {
            margin-top: 1rem;
        }

        .contact__channels-title {
            margin-bottom: 2rem;
           
        }

        .contact__buttons {
            gap: 1em;
        }

        .contact__channel {
            flex: 1;
        }

        .contact__submit {
            width: 100%;
            margin-top: 2rem;
        }

        .contact__submit:hover {
            transform: none;
        }

    }

</style>

<script>
    const channelButtons = document.querySelectorAll('.contact__channel');
    const telegramField = document.querySelector('.contact__telegram-field') as HTMLElement;

    channelButtons.forEach((button) => {
        button.addEventListener('click', () => {

            channelButtons.forEach((item) => {
                item.classList.remove('is-active');
            });

            button.classList.add('is-active');

            if (button.textContent?.trim() === 'Telegram') {
                telegramField.hidden = false;
            } else {
                telegramField.hidden = true;
            }
        });
    });
</script>