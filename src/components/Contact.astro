---

---

<section class="contact" id="contact">

    <div class="container">

        <div class="contact__grid">

            <div class="contact__left">

                <div class="contact__eyebrow">
                    <span>11</span>
                    Start here
                </div>

                <h2 class="contact__title">
                    Tell us what you're building
                </h2>

                <div class="contact__person">

                    <div class="contact__person-image">
                        <img src="/roman_minaev_contact.webp" alt="">
                    </div>

                    <div class="contact__person-info">
                        <p class="contact__person-name">
                            Roman Minaev
                        </p>

                        <p class="contact__person-role">
                            Founder of Woodara
                        </p>
                    </div>

                </div>

            </div>


            <div class="contact__right">

                <p class="contact__intro">
                    Send a spec, a render, or just a rough scope.<br>
                    You'll get a comparative read on cost and timeline before you commit to anything.
                </p>

                <form class="contact__form" novalidate>

                    <div class="contact__field">
                        <label for="name">
                            Your name
                        </label>

                        <input
                            type="text"
                            id="name"
                            name="name"
                            autocomplete="name"
                            required
                        >
                    </div>


                    <div class="contact__field">
                        <label for="company">
                            Company
                        </label>

                        <span class="contact__optional">
                            optional
                        </span>

                        <input
                            type="text"
                            id="company"
                            name="company"
                            autocomplete="organization"
                        >
                    </div>


                    <div class="contact__field contact__field--select">

                        <label for="business-type">
                            Type project
                        </label>

                        <select
                            id="business-type"
                            name="business-type"
                            required
                        >
                            <option value="" disabled selected>
                                Select type project
                            </option>

                            <option value="hotel-apartments">
                                Hotel / Apartments
                            </option>

                            <option value="villa-complex">
                                Villa Complex
                            </option>

                            <option value="private-villa">
                                Private Villa
                            </option>

                            <option value="restaurant">
                                Restaurant
                            </option>

                            <option value="other">
                                Other
                            </option>
                        </select>

                    </div>


                    <div class="contact__field">

                        <label for="phone">
                            Phone number
                        </label>

                        <div class="contact__input-group">

                            <span class="contact__input-prefix">
                                +
                            </span>

                            <input
                                type="tel"
                                id="phone"
                                name="phone"
                                inputmode="numeric"
                                autocomplete="tel"
                                pattern="[0-9]+"
                                required
                            >

                        </div>

                    </div>


                    <div class="contact__field contact__telegram-field" hidden>

                        <label for="telegram">
                            Telegram link
                        </label>

                        <div class="contact__input-group">

                            <span class="contact__input-prefix">
                                @
                            </span>

                            <input
                                type="text"
                                id="telegram"
                                name="telegram"
                                autocomplete="username"
                            >

                        </div>

                    </div>


                    <fieldset class="contact__channels">

                        <legend class="contact__channels-title">
                            Convenient communication format
                        </legend>

                        <div class="contact__buttons">

                            <button
                                type="button"
                                class="contact__channel is-active"
                                data-channel="Call"
                            >
                                Call
                            </button>

                            <button
                                type="button"
                                class="contact__channel"
                                data-channel="WhatsApp"
                            >
                                WhatsApp
                            </button>

                            <button
                                type="button"
                                class="contact__channel"
                                data-channel="Telegram"
                            >
                                Telegram
                            </button>

                        </div>

                    </fieldset>


                    <button
                        type="submit"
                        class="contact__submit"
                    >
                        Leave a request
                    </button>

                </form>

            </div>

        </div>

    </div>

</section>

<style>

    .contact {
        background-color: #111111;
        padding: 10rem 0;
        border-bottom: 0.05rem solid #E3E3E3;
    }

    .contact .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .contact__grid {
        display: grid;
        grid-template-columns: 50% 50%;
        gap: 0;
    }

    .contact__left {
        min-width: 0;
        padding-right: 8rem;
    }

    .contact__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 6rem;
        color: #E3E3E3;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.6rem;
        line-height: 1;
        letter-spacing: -0.03em;
        text-transform: uppercase;
    }

    .contact__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .contact__eyebrow span {
        color: var(--color-accent);
    }

    .contact__title {
        max-width: 65rem;
        color: #fff;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .contact__person {
        display: flex;
        align-items: center;
        gap: 3rem;
        margin-top: 10rem;
    }

    .contact__person-image {
        width: 15.2rem;
        height: 15.2rem;
        flex-shrink: 0;
        overflow: hidden;
        border-radius: 50%;
    }

    .contact__person-image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .contact__person-info {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }

    .contact__person-name {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 2.2rem;
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .contact__person-role {
        color: #E3E3E3;
        font-family: 'Outfit', sans-serif;
        font-size: 1.6rem;
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .contact__right {
        min-width: 0;
        padding: 9rem 0 0 4rem;
    }

    .contact__intro {
        max-width: 45rem;
        margin-bottom: 10rem;
        color: #E3E3E3;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .contact__form {
        width: 100%;
        max-width: 60rem;
    }

    .contact__field {
        position: relative;
        margin-bottom: 4rem;
    }

    .contact__field label {
        position: absolute;
        top: -0.9rem;
        left: 2rem;
        z-index: 1;
        padding: 0 1rem;
        background-color: #111111;
        color: #E3E3E3;
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        line-height: 1;
        letter-spacing: -0.03em;
        transition: color 0.2s ease;
    }

    .contact__field input,
    .contact__field select {
        width: 100%;
        height: 5.8rem;
        border: 0.05rem solid #888888;
        border-radius: 0.5rem;
        outline: none;
        background: transparent;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        transition: border-color 0.2s ease;
    }

    .contact__field input {
        padding: 0 2rem;
    }

    .contact__field select {
        padding: 0 4rem 0 2rem;
        color: #F4F3F0;
        cursor: pointer;
        appearance: none;
        -webkit-appearance: none;
    }

    .contact__field select option {
        color: #151516;
        background-color: #F4F3F0;
    }

    .contact__field--select::after {
        content: "";
        position: absolute;
        top: 50%;
        right: 2rem;
        width: 0.6rem;
        height: 0.6rem;
        border-right: 0.1rem solid #F4F3F0;
        border-bottom: 0.1rem solid #F4F3F0;
        transform: translateY(-70%) rotate(45deg);
        pointer-events: none;
    }

    .contact__field:hover label,
    .contact__field:focus-within label {
        color: #fff;
    }

    .contact__field:hover input,
    .contact__field:hover select,
    .contact__field:focus-within input,
    .contact__field:focus-within select,
    .contact__field:hover .contact__input-group,
    .contact__field:focus-within .contact__input-group {
        border-color: #fff;
    }

    .contact__optional {
        position: absolute;
        top: 50%;
        right: 2rem;
        transform: translateY(-50%);
        color: #E3E3E3;
        font-family: 'Outfit', sans-serif;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
    }

    /* Shared input group */

    .contact__input-group {
        display: flex;
        align-items: center;
        width: 100%;
        height: 5.8rem;
        border: 0.05rem solid #888888;
        border-radius: 0.5rem;
        transition: border-color 0.2s ease;
    }

    .contact__input-prefix {
        flex-shrink: 0;
        padding-left: 2rem;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        line-height: 1;
    }

    .contact__input-group input {
        height: 100%;
        padding: 0 2rem 0 0.6rem;
        border: none;
        border-radius: 0;
    }

    .contact__input-group input:focus {
        border: none;
    }

    /* Channels */

    .contact__channels {
        min-width: 0;
        margin: 1rem 0 0;
        padding: 0;
        border: 0;
    }

    .contact__channels-title {
        margin: 0 0 2rem;
        padding: 0;
        color: #E3E3E3;
        font-family: 'Outfit', sans-serif;
        font-size: 1.5rem;
    }

    .contact__buttons {
        display: flex;
        gap: 1rem;
    }

    .contact__channel {
        padding: 1.2rem 2.2rem;
        border: 0.05rem solid #888888;
        border-radius: 0.3rem;
        background: transparent;
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 1.6rem;
        font-weight: 400;
        letter-spacing: -0.03em;
        cursor: pointer;
    }

    .contact__channel.is-active {
        border-color: #fff;
        background-color: #fff;
        color: #111111;
    }

    .contact__submit {
        margin-top: 4rem;
        padding: 1.5rem 2.7rem;
        border: none;
        background-color: #fff;
        color: #111111;
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        font-weight: 400;
        letter-spacing: -0.03em;
        cursor: pointer;
        transition: transform 0.3s ease;
    }

    .contact__submit:hover {
        transform: translateY(-2px);
    }

    /* Validation */

    .contact__form.is-submitted input:invalid,
    .contact__form.is-submitted select:invalid {
        border-color: #ff3b30;
    }

    .contact__form.is-submitted .contact__field:has(.contact__input-group input:invalid) .contact__input-group {
        border-color: #ff3b30;
    }

    .contact__field input:-webkit-autofill,
    .contact__field input:-webkit-autofill:hover,
    .contact__field input:-webkit-autofill:focus {
        -webkit-text-fill-color: #fff;
        -webkit-box-shadow: 0 0 0 100rem #111111 inset;
        box-shadow: 0 0 0 100rem #111111 inset;
    }

    /* Mobile */

    @media (max-width: 768px) {

        .contact {
            padding: 6rem 0;
        }

        .contact__grid {
            grid-template-columns: 1fr;
        }

        .contact__left {
            padding-right: 0;
        }

        .contact__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .contact__title {
            max-width: 100%;
            margin-bottom: 5rem;
            font-size: 3.6rem;
        }

        .contact__person {
            margin-top: 0;
            margin-bottom: 5rem;
            gap: 2rem;
        }

        .contact__person-image {
            width: 9rem;
            height: 9rem;
        }

        .contact__person-info {
            gap: 0.6rem;
        }

        .contact__person-name {
            font-size: 1.8rem;
        }

        .contact__person-role {
            font-size: 1.4rem;
        }

        .contact__right {
            padding: 0;
        }

        .contact__intro {
            max-width: 100%;
            margin-bottom: 5rem;
            font-size: 1.4rem;
        }

        .contact__form {
            max-width: 100%;
        }

        .contact__field {
            margin-bottom: 3rem;
        }

        .contact__field label {
            left: 1.6rem;
            font-size: 1.6rem;
        }

        .contact__field input,
        .contact__field select {
            height: 5.6rem;
            font-size: 1.6rem;
        }

        .contact__field input {
            padding: 0 1.6rem;
        }

        .contact__field select {
            padding: 0 4rem 0 1.6rem;
        }

        .contact__field--select::after {
            right: 1.6rem;
        }

        .contact__optional {
            right: 1.6rem;
            font-size: 1.4rem;
        }

        .contact__input-group {
            height: 5.6rem;
        }

        .contact__input-prefix {
            padding-left: 1.6rem;
            font-size: 1.6rem;
        }

        .contact__input-group input {
            padding: 0 1.6rem 0 0.6rem;
            font-size: 1.6rem;
        }

        .contact__channels {
            margin-top: 1rem;
        }

        .contact__channels-title {
            margin-bottom: 2rem;
        }

        .contact__buttons {
            gap: 1rem;
        }

        .contact__channel {
            flex: 1;
        }

        .contact__submit {
            width: 100%;
            margin-top: 2rem;
        }

        .contact__submit:hover {
            transform: none;
        }
    }

</style>

<script>
    const contactForm = document.querySelector('.contact__form') as HTMLFormElement;
    const channelButtons = document.querySelectorAll('.contact__channel');
    const telegramField = document.querySelector('.contact__telegram-field') as HTMLElement;
    const telegramInput = document.querySelector('#telegram') as HTMLInputElement;
    const phoneInput = document.querySelector('#phone') as HTMLInputElement;

    channelButtons.forEach((button) => {
        button.addEventListener('click', () => {

            channelButtons.forEach((item) => {
                item.classList.remove('is-active');
            });

            button.classList.add('is-active');

            const isTelegram = button.getAttribute('data-channel') === 'Telegram';

            telegramField.hidden = !isTelegram;
            telegramInput.required = isTelegram;

            if (!isTelegram) {
                telegramInput.value = '';
            }
        });
    });

    phoneInput.addEventListener('input', () => {
        phoneInput.value = phoneInput.value.replace(/\D/g, '');
    });

    contactForm.addEventListener('submit', async (event) => {
        event.preventDefault();

        contactForm.classList.add('is-submitted');

        if (!contactForm.checkValidity()) {
            return;
        }

        const submitButton = contactForm.querySelector('.contact__submit') as HTMLButtonElement;
        if (submitButton) {
            submitButton.disabled = true;
        }

        // Gather standard form fields (name, company, business-type, phone, telegram)
        const formData = new FormData(contactForm);
        const data: Record<string, any> = Object.fromEntries(formData.entries());

        // Find active communication channel
        const activeChannelBtn = document.querySelector('.contact__channel.is-active');
        const selectedChannel = activeChannelBtn ? activeChannelBtn.getAttribute('data-channel') : 'Call';
        data['communicationMethod'] = selectedChannel;

        // Analytics and page metadata matching ClickUp requirements
        data['page'] = window.location.href;
        data['cta'] = 'Contact Form';

        // Parse URL parameters for UTM tracking variables
        const urlParams = new URLSearchParams(window.location.search);
        data['utm_source'] = urlParams.get('utm_source') || '';
        data['utm_campaign'] = urlParams.get('utm_campaign') || '';
        data['utm_medium'] = urlParams.get('utm_medium') || '';
        data['utm_content'] = urlParams.get('utm_content') || '';

        try {
            
            const response = await fetch('https://hook.eu2.make.com/4cslxzn9dhuea8i7yphpxh1iabeorni8', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(data),
            });

            if (response.ok) {
                alert('Success! Thank you.');
                contactForm.reset();
                contactForm.classList.remove('is-submitted');
                
                // Reset communication channels to default layout
                channelButtons.forEach((item) => item.classList.remove('is-active'));
                if (channelButtons[0]) channelButtons[0].classList.add('is-active');
                telegramField.hidden = true;
                telegramInput.required = false;
            } else {
                alert('Server error. Please try again.');
            }
        } catch (error) {
            console.error('Network submission error:', error);
            alert('Connection error.');
        } finally {
            if (submitButton) {
                submitButton.disabled = false;
            }
        }
    });
</script>