---

<section class="hero">

    <div class="container">

        <div class="hero__content">

            <div class="hero__main">

                <div class="hero__eyebrow">
                    <span>450+</span>
                    Verified factories · Indonesia & China
                </div>

                <h1 class="hero__title">
                    We fit out your development — <span>on budget, on schedule,</span> without you managing a single factory.
                </h1>

                <p class="hero__description">
                    Woodara runs the sourcing, tendering, quality control and logistics behind your interiors, so developers, hospitality operators and construction teams building in Bali get transparent factory pricing and one point of control — not agency mark-ups and scattered vendors.
                </p>

            </div>

            <div class="hero__aside">

                <div class="hero__stat">
                    15-25%
                </div>

                <p class="hero__stat-description">
                    Typical procurement savings vs. sourcing direct from a single factory — from tendering within a network of 450+ verified factories instead of accepting one quote.
                </p>

                <div class="hero__actions">

                    <a href="#contact" class="hero__button">
                        Get a project review
                    </a>

                    <a href="#projects" class="hero__button hero__button--secondary">
                        See completed projects
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>

<style>

    .hero {
        width: 100%;
        min-height: calc(100vh - 6.2rem);
        background-color: #F4F3F0;
        display: flex;
        border-bottom: 0.05rem solid #888888;
    }

    .hero .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .hero__content {
        min-height: calc(100vh - 6.4rem);
        display: grid;
        grid-template-columns: 58% 42%;
    }

    .hero__main {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding-top: 12rem;
        padding-right: 6.4rem;
        padding-bottom: 24rem;
    }

    .hero__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .hero__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .hero__eyebrow span {
        color: var(--color-accent);
    }

    .hero__title {
        max-width: 60rem;
        color: #151516;
        font-size: clamp(4.8rem, 4.4vw, 6.4rem);
        margin-bottom: 4rem;
    }


    .hero__title span {
        color: var(--color-accent);
    }

    .hero__description {
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .hero__aside {
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        padding-top: 12rem;
        padding-left: 6.4rem;
        padding-bottom: 24rem;
        border-left: 0.05rem solid #888888;
    }

    .hero__stat {
        color: var(--color-accent);
        font-size: clamp(4.8rem, 4.4vw, 6.4rem);
        font-family: 'TT Firs Neue', sans-serif;
        font-weight: 400;
        line-height: 1.1;
        letter-spacing: -0.03em;
        margin-bottom: 2rem;
    }

    .hero__stat-description {
        max-width: 58rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 5rem;
    }

    .hero__actions {
        display: flex;
        align-items: center;
        gap: 1rem;
    }

    .hero__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: "Outfit", sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        padding: 1.5rem 2.7rem;
        font-weight: 400;
        border: 0.1rem solid #888888;
        background-color: #151516;
        color: #fff;
        text-decoration: none;
        cursor: pointer;

        transition: 0.3s ease;
    }

    .hero__button:hover {
        transform: translateY(-2px);
    }

    .hero__button--secondary {
        background-color: transparent;
        color: #151516;
    }

    @media (max-width: 1440px) {

        .hero__main {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding-top: 12rem;
            padding-right: 6.4rem;
            padding-bottom: 12rem;
        }

        .hero__aside {
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding-top: 12rem;
            padding-left: 6.4rem;
            padding-bottom: 12rem;
            border-left: 0.05rem solid #888888;
        }

        .hero__title {
            max-width: 60rem;
            color: #151516;
            font-size: 5.2rem;
            margin-bottom: 4rem;
        }

        .hero__stat {
            color: var(--color-accent);
            font-size: 5.2rem;
            font-family: 'TT Firs Neue', sans-serif;
            font-weight: 400;
            line-height: 1.1;
            letter-spacing: -0.03em;
            margin-bottom: 2rem;
        }

    }
    @media (max-width: 768px) {

        .hero {
            min-height: auto;
            padding: 6rem 0;
        }

        .hero__content {
            min-height: auto;
            display: flex;
            flex-direction: column;
        }

        .hero__main {
            padding: 0;
        }

        .hero__eyebrow {
            margin-bottom: 4rem;
            gap: 1rem;
            font-size: 1.3rem;
        }

        .hero__title {
            max-width: none;
            margin-bottom: 3rem;
            font-size: 4.2rem;
        }

        .hero__description {
            margin-bottom: 0;
            font-size: 1.4rem;
        }

        .hero__aside {
            padding: 3rem 0 0;
            margin-top: 4rem;
            border-left: none;
            border-top: 0.05rem solid #888888;
        }

        .hero__stat {
            margin-bottom: 1.4rem;
            font-size: 4.8rem;
        }

        .hero__stat-description {
            max-width: none;
            margin-bottom: 3rem;
            font-size: 1.4rem;
        }

        .hero__actions {
            width: 100%;
            flex-direction: column;
            align-items: stretch;
            gap: 1.4rem;
        }

        .hero__button {
            width: 100%;
        }

        .hero__button:hover {
            transform: none;
        }

    }

    @media (max-width: 1024px) {

        .hero__actions {
            flex-direction: column;
            align-items: stretch;
            gap: 1rem;
        }

        .hero__button {
            width: 100%;
            white-space: nowrap;
        }

    }


    

</style>