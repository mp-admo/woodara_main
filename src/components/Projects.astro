<style>

    .projects {
        background-color: #F4F3F0;
        padding: 10rem 0;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .projects__header {
        margin-bottom: 6rem;
    }

    .projects__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .projects__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .projects__eyebrow span {
        color: var(--color-accent);
    }

    .projects__header-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: end;
    }

    .projects__title {
        max-width: 60rem;
        color: #151516;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .projects__description {
        max-width: 48rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 0.6rem;
    }

    .projects__list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5.5rem 3.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .projects__item {
        min-width: 0;
    }

    .projects__item.is-hidden {
        display: none;
    }

    .projects__image {
        width: 100%;
        overflow: hidden;
    }

    .projects__image img {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        pointer-events: none;
    }

    .projects__info {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 0.05rem solid #888888;
    }

    .projects__meta {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .projects__name {
        color: #151516;
        font-family: 'Outfit', sans-serif;
        font-weight: 400;
        font-size: 2rem;
        line-height: 1.1;
        letter-spacing: -0.03rem;
    }

    .projects__category {
        color: #58585A;
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        line-height: 1.1;
        letter-spacing: -0.03rem;
    }

    .projects__number {
        flex-shrink: 0;
        color: #151516;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 5.2rem;
        line-height: 1;
        letter-spacing: -0.03em;
        margin-top: 0.4rem;
    }

    .projects__more {
        display: flex;
        align-items: center;
        gap: 6rem;
        margin-top: 8rem;
    }

    .projects__more::after {
        content: "";
        flex: 1;
        height: 0.05rem;
        background-color: #888888;
    }

    .projects__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: 'Outfit', sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        padding: 1.5rem 2.7rem;
        border: 0.1rem solid #888888;
        background-color: transparent;
        color: #151516;
        text-decoration: none;
        cursor: pointer;
        transition: 0.3s ease;
    }

    .projects__button:hover {
        transform: translateY(-2px);
    }

    @media (max-width: 768px) {

        .projects {
            padding: 6rem 0;
        }

        .projects__header {
            margin-bottom: 5rem;
        }

        .projects__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .projects__header-content {
            display: flex;
            flex-direction: column;
            gap: 0;
            align-items: stretch;
        }

        .projects__title {
            max-width: 100%;
            margin-bottom: 3rem;
            font-size: 3.6rem;
        }

        .projects__description {
            max-width: 100%;
            font-size: 1.4rem;
            margin-bottom: 0;
        }

        .projects__list {
            grid-template-columns: 1fr;
            gap: 5rem;
        }

        .projects__info {
            margin-top: 2.4rem;
            padding-top: 1.6rem;
            gap: 1.6rem;
        }

        .projects__meta {
            gap: 0.4rem;
        }

        .projects__meta span {
            font-size: 1.8rem;
            line-height: 1.1;
        }

        .projects__number {
            font-size: 4.2rem;
            margin-top: 0.4rem;
        }

        .projects__more {
            margin-top: 5rem;
        }

        .projects__more::after {
            display: none;
        }

        .projects__button {
            width: 100%;
        }

        .projects__button:hover {
            transform: none;
        }

    }

</style>

<script>

const projectsButton = document.querySelector('.projects__button') as HTMLElement | null;
const projects = document.querySelectorAll('.projects__item');

if (projectsButton && projects.length) {
  const desktopVisibleCount = 12;
  const mobileVisibleCount = 6;
  const batchSize = 6;
  
  let mobileVisible = mobileVisibleCount;
  const isMobile = () => window.innerWidth <= 768;

  function updateProjects() {
    // Безопасность: если кнопка не найдена, прерываем выполнение
    if (!projectsButton) return; 

    if (isMobile()) {
      projects.forEach((project, index) => {
        project.classList.toggle('is-hidden', index >= mobileVisible);
      });

      if (mobileVisible >= projects.length) {
        projectsButton.textContent = 'Show less';
        projectsButton.classList.add('is-expanded');
      } else {
        projectsButton.textContent = 'More Projects';
        projectsButton.classList.remove('is-expanded');
      }
    } else {
      projects.forEach((project, index) => {
        project.classList.toggle('is-hidden', index >= desktopVisibleCount);
      });

      // Скрываем кнопку на десктопе, если проектов изначально меньше лимита
      if (projects.length <= desktopVisibleCount) {
        projectsButton.style.display = 'none';
      } else {
        projectsButton.style.display = 'block';
        
        // Управляем текстом кнопки в зависимости от её состояния на десктопе
        if (projectsButton.classList.contains('is-expanded')) {
          projectsButton.textContent = 'Show less';
        } else {
          projectsButton.textContent = 'More Projects';
        }
      }
    }
  }

  projectsButton.addEventListener('click', () => {
    if (isMobile()) {
      if (mobileVisible < projects.length) {
        mobileVisible += batchSize;
        updateProjects();
      } else {
        mobileVisible = mobileVisibleCount;
        updateProjects();
        setTimeout(() => {
          projectsButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 0);
      }
    } else {
      const isExpanded = projectsButton.classList.contains('is-expanded');
      
      if (!isExpanded) {
        projects.forEach((project, index) => {
          if (index >= desktopVisibleCount) {
            project.classList.remove('is-hidden');
          }
        });
        projectsButton.classList.add('is-expanded');
        projectsButton.textContent = 'Show less';
      } else {
        projects.forEach((project, index) => {
          if (index >= desktopVisibleCount) {
            project.classList.add('is-hidden');
          }
        });
        projectsButton.classList.remove('is-expanded');
        projectsButton.textContent = 'More Projects';
        setTimeout(() => {
          projectsButton.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }, 0);
      }
    }
  });

  // Добавляем слушатель изменения экрана для корректного переключения таблиц
  window.addEventListener('resize', updateProjects);

  // Инициализация при первой загрузке страницы
  updateProjects();
}

</script>
