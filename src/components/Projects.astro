<style>

    .projects {
        background-color: #F4F3F0;
        padding: 10rem 0;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .projects__header {
        margin-bottom: 6rem;
    }

    .projects__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .projects__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .projects__eyebrow span {
        color: #2E7C77;
    }

    .projects__header-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: end;
    }

    .projects__title {
        max-width: 60rem;
        color: #151516;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .projects__description {
        max-width: 48rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 0.6rem;
    }

    .projects__list {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 5.5rem 3.5rem;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .projects__item {
        min-width: 0;
    }

    .projects__item.is-hidden {
        display: none;
    }

    .projects__image {
        width: 100%;
        overflow: hidden;
    }

    .projects__image img {
        display: block;
        width: 100%;
        height: auto;
        user-select: none;
        -webkit-user-drag: none;
        pointer-events: none;
    }

    .projects__info {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 2rem;
        margin-top: 4rem;
        padding-top: 2rem;
        border-top: 0.05rem solid #888888;
    }

    .projects__meta {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .projects__meta span {
        color: #58585A;
        font-family: 'Outfit', sans-serif;
        font-size: 2rem;
        line-height: 1.1;
        letter-spacing: -0.03rem;
    }

    .projects__meta span:first-child {
        color: #151516;
    }

    .projects__number {
        flex-shrink: 0;
        color: #151516;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 5.2rem;
        line-height: 1;
        letter-spacing: -0.03rem;
        margin-top: 0.7rem;
    }

    .projects__more {
        display: flex;
        align-items: center;
        gap: 6rem;
        margin-top: 8rem;
    }

    .projects__more::after {
        content: "";
        flex: 1;
        height: 0.05rem;
        background-color: #888888;
    }

    .projects__button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-family: Poppins, sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        padding: 1.3rem 2.4rem;
        border: 0.1rem solid #888888;
        background-color: transparent;
        color: #151516;
        text-decoration: none;
        cursor: pointer;
        transition: 0.3s ease;
    }

    .projects__button:hover {
        transform: translateY(-2px);
    }

</style>

<script>
    const projectsButton = document.querySelector('.projects__button');
    const hiddenProjects = document.querySelectorAll('.projects__item.is-hidden');

    projectsButton?.addEventListener('click', () => {

        const isExpanded = projectsButton.classList.contains('is-expanded');

        if (!isExpanded) {

            // Открываем проекты 13–24
            hiddenProjects.forEach((project) => {
                project.classList.remove('is-hidden');
            });

            projectsButton.classList.add('is-expanded');
            projectsButton.textContent = 'Show less';

        } else {

            // Закрываем проекты 13–24
            hiddenProjects.forEach((project) => {
                project.classList.add('is-hidden');
            });

            projectsButton.classList.remove('is-expanded');
            projectsButton.textContent = 'View all projects';

            // Возвращаем пользователя к кнопке
            setTimeout(() => {
                projectsButton.scrollIntoView({
                    behavior: 'smooth',
                    block: 'center'
                });
            }, 0);
        }

    });
</script>
