<style>

    .projects {
        background-color: #F4F3F0;
        padding: 10rem 0;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .projects__header {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8rem;
        margin-bottom: 6rem;
    }

    .projects__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .projects__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .projects__eyebrow span {
        color: #2E7C77;
    }

    .projects__title {
        max-width: 70rem;
        color: #151516;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
        margin: 0;
    }

    .projects__intro {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        flex-direction: row;
    }

    .projects__description {
        max-width: 48rem;
        color: #58585A;
        margin-bottom: 0.6rem;
    }

    .projects__controls {
        display: flex;
        gap: 1rem;
    }

    .projects__arrow {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 4rem;
        height: 4rem;
        padding: 0;
        border: 0.05rem solid #888888;
        background-color: transparent;
        cursor: pointer;
        transition:
            border-color 0.3s ease,
            background-color 0.3s ease;
    }

    .projects__arrow img {
        display: block;
    }

    .projects__arrow:hover {
        border-color: #151516;
        background-color: rgba(17, 17, 17, 0.02);
    }

    .projects__list {
        display: flex;
        gap: 2rem;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        cursor: grab;
        user-select: none;
    }

    .projects__list:active {
        cursor: grabbing;
    }

    .projects__list::-webkit-scrollbar {
        display: none;
    }

    .projects__item {
        flex: 0 0 calc((100% - 4rem) / 3);
    }

    .projects__preview {
        display: block;
        width: 100%;
        aspect-ratio: 16 / 9;
        padding: 0;
        border: none;
        background-color: #D9D9D9;
        overflow: hidden;
        cursor: pointer;
    }

    .projects__preview video {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        pointer-events: none;
        user-select: none;
        -webkit-user-drag: none;
    }

    .projects__info {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        padding-top: 2.4rem;
        border-top: 0.05rem solid #888888;
        margin-top: 4rem;
    }

    .projects__meta {
        display: flex;
        flex-direction: column;
        gap: 0.8rem;
    }

    .projects__type {
        font-family: 'Poppins', sans-serif;
        line-height: 1.1;
        color: #151516;
        font-size: 2rem;
    }

    .projects__name {
        font-family: 'Poppins', sans-serif;
        line-height: 1.1;
        color: #58585A;
        font-size: 2rem;
    }

    .projects__number {
        color: #151516;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 5.2rem;
        line-height: 1;
        margin-top: 1rem;
    }

    <!-- плеер -->

    .projects__modal {
        width: min(120rem, calc(100vw - 8rem));
        max-width: none;
        max-height: calc(100vh - 8rem);

        margin: auto;
        padding: 0;

        border: none;
        background: transparent;

        overflow: visible;
    }

    .projects__modal::backdrop {
        background-color: rgba(21, 21, 22, 0.9);
    }

    .projects__modal-video {
        display: block;

        width: 100%;
        max-height: calc(100vh - 8rem);

        object-fit: contain;
    }

    .projects__modal-close {
        position: absolute;

        top: -5rem;
        right: 0;

        width: 4rem;
        height: 4rem;

        padding: 0;
        border: none;

        background: transparent;
        cursor: pointer;
    }

    .projects__modal-close span {
        position: absolute;

        top: 50%;
        left: 50%;

        width: 2.5rem;
        height: 0.1rem;

        background-color: #fff;
    }

    .projects__modal-close span:first-child {
        transform: translate(-50%, -50%) rotate(45deg);
    }

    .projects__modal-close span:last-child {
        transform: translate(-50%, -50%) rotate(-45deg);
    }

</style>

<script>
    const projectsList = document.querySelector('.projects__list') as HTMLElement | null;
    const prevButton = document.querySelector('.projects__arrow--prev') as HTMLElement | null;
    const nextButton = document.querySelector('.projects__arrow--next') as HTMLElement | null;

    if (projectsList && prevButton && nextButton) {

        const getScrollAmount = () => {
            const card = projectsList.querySelector('.projects__item') as HTMLElement | null;
            const gap = parseFloat(getComputedStyle(projectsList).gap);

            if (!card) return 0;

            return (card.offsetWidth + gap) * 3;
        };

        nextButton.addEventListener('click', () => {
            projectsList.scrollBy({
                left: getScrollAmount(),
                behavior: 'smooth'
            });
        });

        prevButton.addEventListener('click', () => {
            projectsList.scrollBy({
                left: -getScrollAmount(),
                behavior: 'smooth'
            });
        });
    }
</script>

<script>
    const projectPreviews = document.querySelectorAll('.projects__preview');

    projectPreviews.forEach((preview) => {
        const video = preview.querySelector('video');

        if (!video) return;

        preview.addEventListener('mouseenter', () => {
            video.currentTime = 0;
            video.play();
        });

        preview.addEventListener('mouseleave', () => {
            video.pause();
            video.currentTime = 0;
        });
    });
</script>

<script>
    const projectPreviews = document.querySelectorAll('.projects__preview');
    const projectModal = document.querySelector('.projects__modal');
    const projectModalVideo = document.querySelector('.projects__modal-video');
    const projectModalClose = document.querySelector('.projects__modal-close');

    if (
        projectModal instanceof HTMLDialogElement &&
        projectModalVideo instanceof HTMLVideoElement &&
        projectModalClose instanceof HTMLButtonElement
    ) {

        projectPreviews.forEach((preview) => {

            const video = preview.querySelector('video');

            if (!(video instanceof HTMLVideoElement)) return;

            preview.addEventListener('click', () => {

                projectModalVideo.src = video.currentSrc || video.src;

                projectModal.showModal();

                projectModalVideo.play();
            });

        });

        const closeModal = () => {
            projectModalVideo.pause();
            projectModalVideo.removeAttribute('src');
            projectModalVideo.load();

            projectModal.close();
        };

        projectModalClose.addEventListener('click', closeModal);

        projectModal.addEventListener('click', (event) => {
            if (event.target === projectModal) {
                closeModal();
            }
        });
    }
</script>