---

<section class="process">

    <div class="container">

        <div class="process__grid">

            <!-- LEFT -->
            <div class="process__left">

                <h2 class="process__title">
                    From render to final install,<br>
                    in five stages
                </h2>


                <div class="process__accordion">

                    <!-- 01 -->
                    <article class="process__item is-active">

                        <div class="process__wrapper">

                            <span class="process__number">
                                01
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Estimate & tender
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        You send renders and a spec. We tender it across our factory network and return a comparative quote, not a single price.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 02 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                02
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Technical specification
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        Your approved designs are translated into detailed, production-ready technical specifications and drawings.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 03 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                03
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Production under supervision
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        Production is monitored through regular factory reporting, inspections and quality checks.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 04 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                04
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Production under supervision
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        Materials and finished pieces are checked against the approved specifications before anything moves to shipping.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 05 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                05
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Logistics & customs
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        We coordinate freight, documentation, customs clearance and delivery through to the project site.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 06 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                06
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Final install & handover
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        Our team manages the final installation, walkthrough and handover so the project is ready to use.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>

                </div>

            </div>


            <!-- RIGHT -->
            <div class="process__right">

                <div class="process__eyebrow">
                    <span>09</span>
                    How we work
                </div>

                <div class="process__image">

                    <img
                        src="/process_image_wdr.png"
                        alt=""
                    >

                </div>

            </div>

        </div>

    </div>

</section>

<style>
    
    .process {
        background-color: #F4F3F0;
        margin-top: 10rem;
        padding-bottom: 8rem;
        border-top: 0.05rem solid #888888;
    }

    .process .container {
        width: 100%;
        max-width: 160rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .process__grid {
        display: grid;
        grid-template-columns: 65.5% 34.5%;
        align-items: stretch;
    }

    .process__left {
        min-width: 0;
        padding: 10rem 8rem 0 10rem;
        border-right: 0.05rem solid #888888;
    }

    .process__title {
        max-width: 70rem;
        margin-bottom:  6rem;
        color: #151516;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .process__accordion {
        width: 100%;
        max-width: 76rem;
        height: 58rem;
    }

    .process__item {
        padding: 3.2rem 0 3.2rem;
        border-bottom: 0.05rem solid #888888;
        cursor: pointer;
    }

    .process__item:first-child {
        padding-top: 0;
    }

    .process__wrapper {
        display: flex;
        align-items: flex-start;
        gap: 3rem;
    }

    .process__number {
        width: 5rem;
        flex-shrink: 0;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03rem;
        color: #2E7C77;
    }

    .process__info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .process__item-title {
        color: #151516;
        font-family: 'Poppins', sans-serif;
    }

    .process__content-box {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.5s ease, opacity 0.35s ease;
    }

    .process__item.is-active .process__content-box {
        max-height: 20rem;
        opacity: 1;
    }

    .process__text {
        max-width: 64rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        padding-top: 2rem;
    }

    .process__right {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .process__eyebrow {
        height: 26.5rem;
        padding: 10rem 0 0 6rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        color: #58585A;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.6rem;
        line-height: 1;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
    }

    .process__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        margin-top: 0.65rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .process__eyebrow span {
        color: #2E7C77;
    }

    .process__image {
        width: 100%;
        overflow: hidden;
    }

    .process__image img {
        display: block;
        width: 100%;
        height: auto;
    }

</style>

<script>
    const processItems = document.querySelectorAll('.process__item');

    processItems.forEach(item => {
        item.addEventListener('click', () => {
            processItems.forEach(otherItem => {
                otherItem.classList.remove('is-active');
            });

            item.classList.add('is-active');
        });
    });
</script>