<section class="process" id="process">

    <div class="container">

        <div class="process__grid">

            <!-- LEFT -->
            <div class="process__left">

                <h2 class="process__title">
                    From render to final install, in five stages
                </h2>


                <div class="process__accordion">

                    <!-- 01 -->
                    <article class="process__item is-active">

                        <div class="process__wrapper">

                            <span class="process__number">
                                01
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Estimate & tender
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        You send renders and a spec. We tender it across our factory network and return a comparative quote, not a single price.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 02 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                02
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Technical specification
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        Your design is translated into production-ready drawings and material call-outs the factory can build from without guesswork.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 03 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                03
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Production under supervision
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        Our account managers and on-site runners work from the factory floor, with weekly reporting and interim inspections.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 04 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                04
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Logistics & customs
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text"> 
                                        Freight, import licensing, certification and customs clearance handled end to end across Jakarta, Surabaya and Denpasar ports.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>


                    <!-- 05 -->
                    <article class="process__item">

                        <div class="process__wrapper">

                            <span class="process__number">
                                05
                            </span>

                            <div class="process__info">

                                <h4 class="process__item-title">
                                    Final install & handover
                                </h4>

                                <div class="process__content-box">

                                    <p class="process__text">
                                        On-site installation, client walk-through and a standing warranty line for anything that needs attention after handover.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </article>

                </div>

            </div>


            <!-- RIGHT -->
            <div class="process__right">

                <div class="process__eyebrow">
                    <span>09</span>
                    How we work
                </div>

                <div class="process__image">

                    <img
                        src="/process_image_wdr.webp" alt=""
                    >

                </div>

            </div>

        </div>

    </div>

</section>

<style>
    
    .process {
        background-color: #F4F3F0;
        margin-top: 10rem;
        padding-bottom: 10rem;
        border-top: 0.05rem solid #888888;
    }

    .process .container {
        width: 100%;
        max-width: 160rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .process__grid {
        display: grid;
        grid-template-columns: 65.5% 34.5%;
        align-items: stretch;
    }

    .process__left {
        min-width: 0;
        padding: 10rem 8rem 0 10rem;
        border-right: 0.05rem solid #888888;
    }

    .process__title {
        max-width: 60rem;
        margin-bottom:  6rem;
        color: #151516;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .process__accordion {
        width: 100%;
        max-width: 76rem;
        height: 49.5rem;
    }

    .process__item {
        padding: 3.2rem 0 3.2rem;
        border-bottom: 0.05rem solid #888888;
        cursor: pointer;
    }

    .process__item:first-child {
        padding-top: 0;
    }

    .process__wrapper {
        display: flex;
        align-items: flex-start;
        gap: 3rem;
    }

    .process__number {
        width: 5rem;
        flex-shrink: 0;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.8rem;
        letter-spacing: -0.03em;
        color: var(--color-accent);
    }

    .process__info {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .process__item-title {
        color: #151516;
        font-family: 'Outfit', sans-serif;
    }

    .process__content-box {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.5s ease, opacity 0.35s ease;
    }

    .process__item.is-active .process__content-box {
        max-height: 20rem;
        opacity: 1;
    }

    .process__text {
        max-width: 64rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        padding-top: 2rem;
    }

    .process__right {
        min-width: 0;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
    }

    .process__eyebrow {
        height: 26.5rem;
        padding: 10rem 0 0 6rem;
        display: flex;
        align-items: flex-start;
        gap: 1rem;
        color: #58585A;
        font-family: 'TT Firs Neue', sans-serif;
        font-size: 1.6rem;
        line-height: 1;
        letter-spacing: -0.03em;
        text-transform: uppercase;
    }

    .process__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        margin-top: 0.65rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .process__eyebrow span {
        color: var(--color-accent);
    }

    .process__image {
        width: 100%;
        overflow: hidden;
    }

    .process__image img {
        display: block;
        width: 100%;
        height: auto;
    }

    @media (max-width: 768px) {

        .process {
            margin-top: 6rem;
            padding-bottom: 6rem;
        }

        .process__grid {
            display: flex;
            flex-direction: column;
        }

        .process__right {
            order: 1;
        }

        .process__eyebrow {
            height: auto;
            padding: 5rem 0 0;
            font-size: 1.3rem;
        }

        .process__image {
            display: none;
        }

        .process__left {
            order: 2;
            padding: 4rem 0 0;
            border-right: none;
        }

        .process__title {
            max-width: 100%;
            margin-bottom: 4rem;
            font-size: 3.6rem;
        }

        .process__accordion {
            max-width: 100%;
            height: auto;
        }

        .process__item {
            padding: 2rem 0;
        }

        .process__item:first-child {
            padding-top: 0;
        }

        .process__wrapper {
            gap: 3rem;
        }

        .process__number {
            width: 2rem;
            font-size: 1.6rem;
            margin-top: 0.1rem;
        }

        .process__item-title {
            font-size: 2.2rem;
        }

        .process__text {
            font-size: 1.4rem;
            padding-top: 1.2rem;
        }

    }

</style>

<script>
    const processItems = document.querySelectorAll('.process__item');

    processItems.forEach(item => {
        item.addEventListener('click', () => {
            processItems.forEach(otherItem => {
                otherItem.classList.remove('is-active');
            });

            item.classList.add('is-active');
        });
    });
</script>