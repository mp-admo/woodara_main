---

---

<section class="faq">

    <div class="container">

        <img
            class="faq__chandelier"
            src="/decorative/decoration_edison_chandelier.webp"
            alt=""
            draggable="false"
        />

        <div class="faq__eyebrow">
            <span>10</span>
            Before you ask
        </div>

        <h2 class="faq__title">
            The questions every procurement lead asks first
        </h2>

        <div class="faq__list">

            <article class="faq__item is-active">

                <div class="faq__question">
                    <h4>
                        What happens if a factory runs behind schedule?
                    </h4>

                    <span class="faq__icon">-</span>
                </div>

                <div class="faq__answer">
                    <p>
                        Large orders can be split across multiple factories in parallel, so one delay doesn't stall the whole order. Your account manager reports on status continuously rather than at the end of the run.
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        How do you guarantee material quality?
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        Every order is tested against its stated spec before shipping. We work only with factories that have passed our audit process, and interim inspections happen during production, not just at final packing.
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        What if something arrives damaged?
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        Our internal packaging standard is built to eliminate damage in transit. When something still goes wrong, it's handled directly with us — not a claims process against a factory you have no relationship with.
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        We can't find the exact piece we need — what then?
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        Send a photo or reference. Across 450+ factories we can usually match it closely; where there's no match, we arrange custom production against your spec.
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        How is this different from hiring our own buyer in Indonesia?
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        A buyer sees the factories they already know. We shortlist and tender every order from a network of 450+ factories, plus handle customs, freight and installation — work that would otherwise mean hiring a logistics team as well as a buyer.
                    </p>
                </div>

            </article>

        </div>

    </div>

</section>

<style>

    .faq {
        background-color: #111111;
        padding: 10rem 0rem;
        border-bottom: 0.05rem solid #E3E3E3;
        position: relative;
        overflow: hidden;
    }

    .faq .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .faq__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #E3E3E3;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .faq__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .faq__eyebrow span {
        color: var(--color-accent);
    }

    .faq__title {
        max-width: 80rem;
        margin-bottom: 6rem;
        color: #fff;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .faq__list {
        width: 100%;
    }

    .faq__item {
        border-top: 0.05rem solid #E3E3E3;
        padding: 3rem 0 3rem;
    }

    .faq__item:last-child {
        border-bottom: 0.05rem solid #E3E3E3;
    }

    .faq__question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }

    .faq__question h4 {
        color: #fff;
        font-family: 'Outfit', sans-serif;
        font-size: 2.2rem;
        font-weight: 300;
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .faq__icon {
        flex-shrink: 0;
        color: var(--color-accent);
        font-family: 'Outfit', sans-serif;
        font-size: 3rem;
        line-height: 1;
    }

    .faq__answer {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.5s ease, opacity 0.35s ease;
    }

    .faq__item.is-active .faq__answer {
        max-height: 20rem;
        opacity: 1;
    }

    .faq__answer p {
        max-width: 80rem;
        margin: 0;
        padding-top: 2rem;
        color: #E3E3E3;
        font-size: 1.5rem;
        line-height: 1.45;
    }

    .faq__chandelier {
        position: absolute;
        width: 70rem;
        left: calc(50% + 3rem);
        top: -6rem;
        z-index: 10;
        pointer-events: none;
    }

    @media (max-width: 768px) {

        .faq {
            padding: 6rem 0;
        }


        .faq__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .faq__title {
            max-width: 100%;
            margin-bottom: 5rem;
            font-size: 3.2rem;
        }

        .faq__item {
            padding: 2.4rem 0;
        }

        .faq__question {
            gap: 5rem;
            align-items: flex-start;
        }

        .faq__question h4 {
            font-size: 1.8rem;
        }

        .faq__answer p {
            max-width: 100%;
            padding-top: 1.2rem;
            font-size: 1.4rem;
            line-height: 1.4;
        }

        .faq__chandelier {
            display: none;
        }

    }

</style>

<script>
    const faqItems = document.querySelectorAll('.faq__item');

    faqItems.forEach((item) => {
        const question = item.querySelector('.faq__question');
        const icon = item.querySelector('.faq__icon');

        if (!question || !icon) return;

        question.addEventListener('click', () => {

            faqItems.forEach((faqItem) => {
                faqItem.classList.remove('is-active');

                const faqIcon = faqItem.querySelector('.faq__icon');

                if (faqIcon) {
                    faqIcon.textContent = '+';
                }
            });

            item.classList.add('is-active');
            icon.textContent = '-';
        });
    });
</script>