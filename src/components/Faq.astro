---
import type { Language } from "../i18n";

const { lang = "en", t } = Astro.props as {
    lang: Language;
    t: (typeof import("../i18n").translations)["en"];
};
---

<section class="faq">

    <div class="container">

        <img
            class="faq__chandelier"
            src="/decorative/decoration_edison_chandelier.webp"
            alt=""
            draggable="false"
        />

        <div class="faq__eyebrow">
            <span>10</span>
            {t.faqEyebrow}
        </div>

        <h2 class="faq__title">
            {t.faqTitle}
        </h2>

        <div class="faq__list">

            <article class="faq__item is-active">

                <div class="faq__question">
                    <h4>
                        {t.faqQuestion1}
                    </h4>

                    <span class="faq__icon">-</span>
                </div>

                <div class="faq__answer">
                    <p>
                        {t.faqAnswer1}
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        {t.faqQuestion2}
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        {t.faqAnswer2}
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        {t.faqQuestion3}
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        {t.faqAnswer3}
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        {t.faqQuestion4}
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        {t.faqAnswer4}
                    </p>
                </div>

            </article>


            <article class="faq__item">

                <div class="faq__question">
                    <h4>
                        {t.faqQuestion5}
                    </h4>

                    <span class="faq__icon">+</span>
                </div>

                <div class="faq__answer">
                    <p>
                        {t.faqAnswer5}
                    </p>
                </div>

            </article>

        </div>

    </div>

</section>

<style>

    .faq {
        background-color: #111111;
        padding: 10rem 0rem;
        border-bottom: 0.05rem solid #E3E3E3;
        position: relative;
        overflow: hidden;
    }

    .faq .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .faq__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-display);
        color: #E3E3E3;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .faq__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #E3E3E3;
        flex-shrink: 0;
    }

    .faq__eyebrow span {
        color: var(--color-accent);
    }

    .faq__title {
        max-width: 80rem;
        margin-bottom: 6rem;
        color: #fff;
        font-size: clamp(4.2rem, 4.4vw, 5.2rem);
    }

    .faq__list {
        width: 100%;
    }

    .faq__item {
        border-top: 0.05rem solid #E3E3E3;
        padding: 3rem 0 3rem;
    }

    .faq__item:last-child {
        border-bottom: 0.05rem solid #E3E3E3;
    }

    .faq__question {
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
    }

    .faq__question h4 {
        color: #fff;
        font-family: var(--font-heading);
        font-size: 2.2rem;
        font-weight: 300;
        line-height: 1.2;
        letter-spacing: -0.03em;
    }

    .faq__icon {
        flex-shrink: 0;
        color: var(--color-accent);
        font-family: var(--font-heading);
        font-size: 3rem;
        line-height: 1;
    }

    .faq__answer {
        max-height: 0;
        overflow: hidden;
        opacity: 0;
        transition: max-height 0.5s ease, opacity 0.35s ease;
    }

    .faq__item.is-active .faq__answer {
        max-height: 20rem;
        opacity: 1;
    }

    .faq__answer p {
        max-width: 80rem;
        margin: 0;
        padding-top: 2rem;
        color: #E3E3E3;
        font-size: 1.5rem;
        line-height: 1.45;
    }

    .faq__chandelier {
        position: absolute;
        width: 70rem;
        left: calc(50% + 3rem);
        top: -6rem;
        z-index: 10;
        pointer-events: none;
    }

    @media (max-width: 768px) {

        .faq {
            padding: 6rem 0;
        }


        .faq__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .faq__title {
            max-width: 100%;
            margin-bottom: 5rem;
            font-size: 3.2rem;
        }

        .faq__item {
            padding: 2.4rem 0;
        }

        .faq__question {
            gap: 5rem;
            align-items: flex-start;
        }

        .faq__question h4 {
            font-size: 1.8rem;
        }

        .faq__answer p {
            max-width: 100%;
            padding-top: 1.2rem;
            font-size: 1.4rem;
            line-height: 1.4;
        }

        .faq__chandelier {
            display: none;
        }

    }

</style>

<script>
    const faqItems = document.querySelectorAll('.faq__item');

    faqItems.forEach((item) => {
        const question = item.querySelector('.faq__question');
        const icon = item.querySelector('.faq__icon');

        if (!question || !icon) return;

        question.addEventListener('click', () => {

            faqItems.forEach((faqItem) => {
                faqItem.classList.remove('is-active');

                const faqIcon = faqItem.querySelector('.faq__icon');

                if (faqIcon) {
                    faqIcon.textContent = '+';
                }
            });

            item.classList.add('is-active');
            icon.textContent = '-';
        });
    });
</script>