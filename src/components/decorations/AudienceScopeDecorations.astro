---

---

<div class="audience-scope-decorations">


    <img
        class="decoration decoration--armchair_01"
        src="/decorative/decoration_armchair_01.webp"
        alt=""
        draggable="false"
        data-rotation="24"
    />

    <img
        class="decoration decoration--chair_02"
        src="/decorative/decoration_chair_02.webp"
        alt=""
        draggable="false"
        data-rotation="20"
    />

    <img
        class="decoration decoration--bedside"
        src="/decorative/decoration_bedside.webp"
        alt=""
        draggable="false"
        data-rotation="5"
    />

    <img
        class="decoration decoration--armchair_02"
        src="/decorative/decoration_armchair_02.webp"
        alt=""
        draggable="false"
        data-rotation="-10"
    />

    <img
        class="decoration decoration--sofa_02"
        src="/decorative/decoration_sofa_02.webp"
        alt=""
        draggable="false"
        data-rotation="23"
    />

    <img
        class="decoration decoration--table"
        src="/decorative/decoration_table.webp"
        alt=""
        draggable="false"
        data-rotation="45"
    />

</div>

<style>

    .audience-scope-decorations {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
    }

    .decoration {
        position: absolute;
        pointer-events: auto;
        will-change: transform;
        transition: transform 0.2s ease-out;
    }

    .decoration--armchair_01 {
        position: absolute;
        width: 18rem;
        left: calc(50% - 40rem);
        top: -5rem;
        transform: rotate(24deg);
    }

    .decoration--chair_02 {
        position: absolute;
        width: 18rem;
        left: calc(50% - 16rem);
        top: -8rem;
        transform: rotate(20deg);
    }

    .decoration--bedside {
        position: absolute;
        width: 14rem;
        left: calc(50% + 8rem);
        top: -4rem;
        transform: rotate(5deg);
    }

    .decoration--armchair_02 {
        position: absolute;
        width: 18rem;
        left: calc(50% + 30rem);
        top: -8rem;
        transform: rotate(-10deg);
    }

    .decoration--sofa_02 {
        position: absolute;
        width: 14rem;
        left: calc(50% + 55rem);
        top: -4rem;
        transform: rotate(23deg);
    }
    

    .decoration--table {
        position: absolute;
        width: 40rem;
        left: calc(50% + 50rem);
        top: 60rem;
        transform: rotate(45deg);
    }


    @media (max-width: 1440px) {

        .decoration--table {
            width: 30rem;
            left: calc(50% + 50rem);
            top: 65rem;
        }

    }

    @media (max-width: 1024px) {

        .decoration {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .decoration {
            display: none;
        }
    }

</style>

<script>
    const decorations = document.querySelectorAll<HTMLElement>('.decoration');

    decorations.forEach((decoration) => {
        const rotation = decoration.dataset.rotation || '0';

        let mouseX = 0;
        let mouseY = 0;
        let animationFrame = 0;

        const updatePosition = () => {
            const rect = decoration.getBoundingClientRect();

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const moveX = ((mouseX - centerX) / centerX) * -10;
            const moveY = ((mouseY - centerY) / centerY) * -10;

            decoration.style.transform =
                `translate(${moveX}px, ${moveY}px) rotate(${rotation}deg)`;

            animationFrame = 0;
        };

        decoration.addEventListener('mousemove', (event) => {
            const rect = decoration.getBoundingClientRect();

            mouseX = event.clientX - rect.left;
            mouseY = event.clientY - rect.top;

            if (!animationFrame) {
                animationFrame = requestAnimationFrame(updatePosition);
            }
        });

        decoration.addEventListener('mouseleave', () => {
            if (animationFrame) {
                cancelAnimationFrame(animationFrame);
                animationFrame = 0;
            }

            decoration.style.transform = `rotate(${rotation}deg)`;
        });
    });
</script>