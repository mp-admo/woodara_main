---

<div class="audience-scope-decorations">


    <img
        class="decoration decoration--pillow-up1"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="24"
    />

    <img
        class="decoration decoration--pillow-up2"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="45"
    />

    <img
        class="decoration decoration--pillow-up3"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="78"
    />

    <img
        class="decoration decoration--pillow-up4"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="120"
    />

    <img
        class="decoration decoration--pillow-up5"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="66"
    />

    <img
        class="decoration decoration--pillow-right"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="66"
    />

</div>

<style>

    .audience-scope-decorations {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
    }

    .decoration {
        position: absolute;
        pointer-events: auto;
        will-change: transform;
        transition: transform 0.2s ease-out;
    }

    .decoration--pillow-up1 {
        position: absolute;
        width: 10rem;
        left: calc(50% - 35rem);
        top: -2vh;
        transform: rotate(24deg);
    }

    .decoration--pillow-up2 {
        position: absolute;
        width: 15rem;
        left: calc(50% - 15rem);
        top: 0vh;
        transform: rotate(45deg);
    }

    .decoration--pillow-up3 {
        position: absolute;
        width: 12rem;
        left: calc(50% + 10rem);
        top: -3vh;
        transform: rotate(78deg);
    }

    .decoration--pillow-up4 {
        position: absolute;
        width: 14rem;
        left: calc(50% + 34rem);
        top: -1vh;
        transform: rotate(120deg);
    }

    .decoration--pillow-up5 {
        position: absolute;
        width: 10rem;
        left: calc(50% + 58rem);
        top: -3vh;
        transform: rotate(66deg);
    }
    

    .decoration--pillow-right {
        position: absolute;
        width: 32rem;
        left: calc(50% + 58rem);
        top: 50vh;
        transform: rotate(66deg);
    }

 
    @media (max-width: 1920px) {
        .decoration--pillow-right {
            left: calc(50% + 58rem);
            top: 58vh;
        }

    }

    @media (max-width: 1600px) {
        .decoration--pillow-right {
            left: calc(50% + 58rem);
            top: 62vh;
        }

    }

    @media (max-width: 1024px) {

        .decoration {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .decoration {
            display: none;
        }
    }

</style>

<script>
    const decorations = document.querySelectorAll<HTMLElement>('.decoration');

    decorations.forEach((decoration) => {
        const rotation = decoration.dataset.rotation || '0';

        let mouseX = 0;
        let mouseY = 0;
        let animationFrame = 0;

        const updatePosition = () => {
            const rect = decoration.getBoundingClientRect();

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const moveX = ((mouseX - centerX) / centerX) * -10;
            const moveY = ((mouseY - centerY) / centerY) * -10;

            decoration.style.transform =
                `translate(${moveX}px, ${moveY}px) rotate(${rotation}deg)`;

            animationFrame = 0;
        };

        decoration.addEventListener('mousemove', (event) => {
            const rect = decoration.getBoundingClientRect();

            mouseX = event.clientX - rect.left;
            mouseY = event.clientY - rect.top;

            if (!animationFrame) {
                animationFrame = requestAnimationFrame(updatePosition);
            }
        });

        decoration.addEventListener('mouseleave', () => {
            if (animationFrame) {
                cancelAnimationFrame(animationFrame);
                animationFrame = 0;
            }

            decoration.style.transform = `rotate(${rotation}deg)`;
        });
    });
</script>