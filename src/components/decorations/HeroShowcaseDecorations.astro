---

<div class="hero-showcase-decorations">

    <img
        class="decoration decoration--chair"
        src="/decorative/decoration_chair.webp"
        alt=""
        draggable="false"
        data-rotation="25"
    />

    <img
        class="decoration decoration--pillow-left"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="30"
    />

    <img
        class="decoration decoration--pillow-right"
        src="/decorative/decoration_pillow.webp"
        alt=""
        draggable="false"
        data-rotation="66"
    />

    <img
        class="decoration--lamp"
        src="/decorative/decoration_lamp2.webp"
        alt=""
        draggable="false"
    />


</div>

<style>

    .hero-showcase-decorations {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
    }

    .decoration {
        position: absolute;
        pointer-events: auto;
        will-change: transform;
        transition: transform 0.2s ease-out;
    }

    .decoration--chair {
        position: absolute;
        width: 45rem;
        left: calc(50% + 3rem);
        top: 12rem;
        transform: rotate(25deg);
    }

    .decoration--pillow-left {
        position: absolute;
        width: 32rem;
        left: calc(50% - 90rem);
        top: 100rem;
        transform: rotate(30deg);
    }

    .decoration--pillow-right {
        position: absolute;
        width: 24rem;
        left: calc(50% + 60rem);
        top: 82rem;
        transform: rotate(66deg);
    }

    .decoration--lamp {
        position: absolute;
        width: 110rem;
        left: calc(50% + 26rem);
        top: 145rem;
    }

            
    @media (max-width: 1920px) {

        .decoration--chair {
            position: absolute;
            width: 40rem;
            left: calc(50% + 3rem);
            top: 6rem;
            transform: rotate(25deg);
        }

        .decoration--pillow-right {
            width: 24rem;
            left: calc(50% + 58rem);
            top: 63rem;
        }

        .decoration--pillow-left {
            width: 32rem;
            left: calc(50% - 90rem);
            top: 80rem;
        }


        .decoration--lamp {
            position: absolute;
            width: 110rem;
            left: calc(50% + 22rem);
            top: 130rem;
        }
    }

    @media (max-width: 1680px) {

        .decoration--chair {
            width: 38rem;
            left: calc(50% + 3rem);
            top: 6rem;
        }


        .decoration--pillow-right {
            width: 24rem;
            left: calc(50% + 58rem);
            top: 58rem;
        }

        .decoration--pillow-left {
            width: 32rem;
            left: calc(50% - 90rem);
            top: 80rem;
        }


        .decoration--lamp {
            position: absolute;
            width: 110rem;
            left: calc(50% + 20rem);
            top: 124rem;
        }

        
    }

    @media (max-width: 1440px) {

        .decoration--chair {
            position: absolute;
            width: 28rem;
            left: calc(50% - 6rem);
            top: 6rem;
            transform: rotate(25deg);
        }

        .decoration--pillow-left {
            width: 28rem;
            left: calc(50% - 90rem);
            top: 52rem;
        }


        .decoration--pillow-right {
            width: 20rem;
            left: calc(50% + 58rem);
            top: 53rem;
        }

        .decoration--lamp {
            position: absolute;
            width: 110rem;
            left: calc(50% + 12rem);
            top: 90rem;
        }


    }

    @media (max-width: 1024px) {

        .decoration {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .decoration {
            display: none;
        }
    }

</style>

<script>
    const decorations = document.querySelectorAll<HTMLElement>('.decoration');

    decorations.forEach((decoration) => {
        const rotation = decoration.dataset.rotation || '0';

        let mouseX = 0;
        let mouseY = 0;
        let animationFrame = 0;

        const updatePosition = () => {
            const rect = decoration.getBoundingClientRect();

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const moveX = ((mouseX - centerX) / centerX) * -10;
            const moveY = ((mouseY - centerY) / centerY) * -10;

            decoration.style.transform =
                `translate(${moveX}px, ${moveY}px) rotate(${rotation}deg)`;

            animationFrame = 0;
        };

        decoration.addEventListener('mousemove', (event) => {
            const rect = decoration.getBoundingClientRect();

            mouseX = event.clientX - rect.left;
            mouseY = event.clientY - rect.top;

            if (!animationFrame) {
                animationFrame = requestAnimationFrame(updatePosition);
            }
        });

        decoration.addEventListener('mouseleave', () => {
            if (animationFrame) {
                cancelAnimationFrame(animationFrame);
                animationFrame = 0;
            }

            decoration.style.transform = `rotate(${rotation}deg)`;
        });
    });
</script>