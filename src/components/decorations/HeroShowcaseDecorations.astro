---

<div class="hero-showcase-decorations">

    <img
        class="decoration decoration--sofa"
        src="/decorative/decoration_sofa.webp"
        alt=""
        draggable="false"
        data-rotation="-5"
    />

    <img
        class="decoration decoration--chair"
        src="/decorative/decoration_chair.webp"
        alt=""
        draggable="false"
        data-rotation="-20"
    />

    <img
        class="decoration decoration--table"
        src="/decorative/decoration_table_02.webp"
        alt=""
        draggable="false"
        data-rotation="10"
    />


    <img
        class="decoration--lamp"
        src="/decorative/decoration_lamp.webp"
        alt=""
        draggable="false"
    />


</div>

<style>

    .hero-showcase-decorations {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
    }

    .decoration {
        position: absolute;
        pointer-events: auto;
        will-change: transform;
        transition: transform 0.2s ease-out;
    }

    .decoration--sofa {
        position: absolute;
        width: 85rem;
        left: calc(50% - 10rem);
        top: 30rem;
        transform: rotate(-5deg);
    }

    .decoration--chair {
        position: absolute;
        width: 36rem;
        left: calc(50% + 60rem);
        top: 88rem;
        transform: rotate(-20deg);
    }

    .decoration--table {
        position: absolute;
        width: 24rem;
        left: calc(50% - 85rem);
        top: 110rem;
        transform: rotate(10deg);
    }

    .decoration--lamp {
        position: absolute;
        width: 110rem;
        left: calc(50% + 18rem);
        top: 140rem;
    }

            
    @media (max-width: 1920px) {

        .decoration--sofa {
            width: 75rem;
            left: calc(50% - 5rem);
            top: 7rem;
        }

        .decoration--chair {
            width: 36rem;
            left: calc(50% + 60rem);
            top: 59rem;
        }

        .decoration--table {
            width: 24rem;
            left: calc(50% - 85rem);
            top: 80rem;
        }

        .decoration--lamp {
            position: absolute;
            width: 110rem;
            left: calc(50% + 18rem);
            top: 110rem;
        }
        
    }

    @media (max-width: 1680px) {

        .decoration--sofa {
            width: 75rem;
            left: calc(50% - 5rem);
            top: 7rem;
        }

        .decoration--chair {
            width: 36rem;
            left: calc(50% + 60rem);
            top: 59rem;
        }

        .decoration--table {
            width: 24rem;
            left: calc(50% - 85rem);
            top: 80rem;
        }

        .decoration--pillow-left {
            width: 32rem;
            left: calc(50% - 90rem);
            top: 66rem;
        }


        .decoration--lamp {
            width: 110rem;
            left: calc(50% + 18rem);
            top: 110rem;
        }

        
    }

    @media (max-width: 1440px) {
        
        .decoration--sofa {
            width: 65rem;
            left: calc(50% - 3rem);
            top: 5rem;
        }

        .decoration--chair {
            width: 28rem;
            left: calc(50% + 60rem);
            top: 48rem;
        }

        .decoration--table {
            width: 20rem;
            left: calc(50% - 80rem);
            top: 58rem;
        }

        .decoration--lamp {
            width: 105rem;
            left: calc(50% + 15rem);
            top: 90rem;
        }


    }

    @media (max-width: 1024px) {

        .decoration {
            display: none;
        }

        .decoration--lamp {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .decoration {
            display: none;
        }

        .decoration--lamp {
            display: none;
        }
    }

</style>

<script>
    const decorations = document.querySelectorAll<HTMLElement>('.decoration');

    decorations.forEach((decoration) => {
        const rotation = decoration.dataset.rotation || '0';

        let mouseX = 0;
        let mouseY = 0;
        let animationFrame = 0;

        const updatePosition = () => {
            const rect = decoration.getBoundingClientRect();

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const moveX = ((mouseX - centerX) / centerX) * -10;
            const moveY = ((mouseY - centerY) / centerY) * -10;

            decoration.style.transform =
                `translate(${moveX}px, ${moveY}px) rotate(${rotation}deg)`;

            animationFrame = 0;
        };

        decoration.addEventListener('mousemove', (event) => {
            const rect = decoration.getBoundingClientRect();

            mouseX = event.clientX - rect.left;
            mouseY = event.clientY - rect.top;

            if (!animationFrame) {
                animationFrame = requestAnimationFrame(updatePosition);
            }
        });

        decoration.addEventListener('mouseleave', () => {
            if (animationFrame) {
                cancelAnimationFrame(animationFrame);
                animationFrame = 0;
            }

            decoration.style.transform = `rotate(${rotation}deg)`;
        });
    });
</script>