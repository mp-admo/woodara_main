---

<div class="workflow-decorations">


    <img
        class="decoration decoration--wall-sconce"
        src="/decorative/decoration_wall_sconce.webp"
        alt=""
        draggable="false"
    />

    <img
        class="decoration decoration--lounge-chair"
        src="/decorative/decoration_lounge_chair.webp"
        alt=""
        draggable="false"
    />

    <img
        class="decoration decoration--table"
        src="/decorative/decoration_table_03.webp"
        alt=""
        draggable="false"
    />

    <img
        class="decoration decoration--chair"
        src="/decorative/decoration_chair_03.webp"
        alt=""
        draggable="false"
        data-rotation="-10"
    />

    <img
        class="decoration decoration--bathtub"
        src="/decorative/decoration_bathtub.webp"
        alt=""
        draggable="false"
    />


</div>

<style>

    .workflow-decorations {
        position: absolute;
        inset: 0;
        z-index: 10;
        pointer-events: none;
    }

    .decoration {
        position: absolute;
        pointer-events: auto;
        will-change: transform;
        transition: transform 0.2s ease-out;
    }

    .decoration--wall-sconce {
        position: absolute;
        width: 26rem;
        left: calc(50% - 42rem);
        top: 72rem;
    }

    .decoration--lounge-chair {
        position: absolute;
        width: 62rem;
        left: calc(50% - 96rem);
        top: 114rem;
    }

    .decoration--table {
        position: absolute;
        width: 45rem;
        left: calc(50% + 0rem);
        top: 136rem;
    }

    .decoration--chair {
        position: absolute;
        width: 35rem;
        left: calc(50% + 50rem);
        top: 195rem;
        transform: rotate(-10deg);
    }

    .decoration--bathtub {
        position: absolute;
        width: 90rem;
        left: calc(50% + 28rem);
        top: 30rem;
    }
    

 
    @media (max-width: 1920px) {

        .decoration--lounge-chair {
            width: 62rem;
            left: calc(50% - 96rem);
            top: 114rem;
        }
    
    

    }

    @media (max-width: 1680px) {

        .decoration--lounge-chair {
            width: 62rem;
            left: calc(50% - 86rem);
            top: 114rem;
        }

        .decoration--table {
            position: absolute;
            width: 40rem;
            left: calc(50% + -2rem);
            top: 140rem;
        }


    }

    @media (max-width: 1440px) {

        .decoration--wall-sconce {
            width: 22rem; 
            left: calc(50% - 40rem);
            top: 73rem;
        }

        .decoration--lounge-chair {
            width: 50rem;
            left: calc(50% - 73rem);
            top: 120rem;
        }

        .decoration--table {
            position: absolute;
            width: 38rem;
            left: calc(50% + 0rem);
            top: 140rem;
        }

        .decoration--chair {
            width: 30rem;
            left: calc(50% + 48rem);
            top: 198rem;
        }


    }

    @media (max-width: 1024px) {

        .decoration {
            display: none;
        }
    }

    @media (max-width: 768px) {
        .decoration {
            display: none;
        }
    }

</style>

<script>
    const decorations = document.querySelectorAll<HTMLElement>('.decoration');

    decorations.forEach((decoration) => {
        const rotation = decoration.dataset.rotation || '0';

        let mouseX = 0;
        let mouseY = 0;
        let animationFrame = 0;

        const updatePosition = () => {
            const rect = decoration.getBoundingClientRect();

            const centerX = rect.width / 2;
            const centerY = rect.height / 2;

            const moveX = ((mouseX - centerX) / centerX) * -10;
            const moveY = ((mouseY - centerY) / centerY) * -10;

            decoration.style.transform =
                `translate(${moveX}px, ${moveY}px) rotate(${rotation}deg)`;

            animationFrame = 0;
        };

        decoration.addEventListener('mousemove', (event) => {
            const rect = decoration.getBoundingClientRect();

            mouseX = event.clientX - rect.left;
            mouseY = event.clientY - rect.top;

            if (!animationFrame) {
                animationFrame = requestAnimationFrame(updatePosition);
            }
        });

        decoration.addEventListener('mouseleave', () => {
            if (animationFrame) {
                cancelAnimationFrame(animationFrame);
                animationFrame = 0;
            }

            decoration.style.transform = `rotate(${rotation}deg)`;
        });
    });
</script>