<section class="categories" id="categories">

    <div class="container">

        <div class="categories__header">

            <div class="categories__eyebrow">
                <span>01</span>
                What you can order
            </div>

            <h3 class="categories__title">
                One supplier account.<br>Nine categories already in production.
            </h3>

            <p class="categories__description">
                Not a roadmap — this is what we've sourced, quality-checked and delivered to sites in Bali already, tendered across the same 450+ factory network as everything else on this page.
            </p>

        </div>

        <ul class="categories__list">

            <!-- Case & wood furniture -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Case & wood furnitre
                </h4>

                <p class="categories__item-info">
                    Wardrobes, cabinets, chairs, tables, bedside tables
                </p>

                <div class="categories__item-image">
                    <img src="/categories/case_&_wood_furniture_image_wdr.webp" alt="Case & wood furniture">
                </div>

            </li>

            <!-- Sofas & beds -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Sofas & beds
                </h4>

                <p class="categories__item-info">
                    Upholstered seating and bed frames
                </p>

                <div class="categories__item-image">
                    <img src="/categories/sofas_&_beds_image_wdr.webp" alt="Sofas & beds">
                </div>

            </li>
            
            <!-- Sanitaryware -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Sanitaryware
                </h4>

                <p class="categories__item-info">
                    Bathroom fixtures and fittings
                </p>

                <div class="categories__item-image">
                    <img src="/categories/sanitaryware_image_wdr.webp" alt="Sanitaryware">
                </div>

            </li>

            <!-- Lighting -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Lighting
                </h4>

                <p class="categories__item-info">
                    General fixtures and track lighting systems
                </p>

                <div class="categories__item-image">
                    <img src="/categories/lighting_image_wdr.webp" alt="Lighting">
                </div>

            </li>

            <!-- Outdoor furniture -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Outdoor furniture
                </h4>

                <p class="categories__item-info">
                    Weather-rated pieces for pool decks, terraces, gardens
                </p>

                <div class="categories__item-image">
                    <img src="/categories/outdoor_furniture_image_wdr.webp" alt="Outdoor furniture">
                </div>

            </li>

            <!-- Mattressess -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Mattresses
                </h4>

                <p class="categories__item-info">
                    Hospitality and residential grade
                </p>

                <div class="categories__item-image">
                    <img src="/categories/mattresses_image_wdr.webp" alt="Mattresses">
                </div>

            </li>

            <!-- Electrical fittings -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Electrical fittings
                </h4>

                <p class="categories__item-info">
                    Switches and sockets
                </p>

                <div class="categories__item-image">
                    <img src="/categories/electrical_fittings_image_wdr.webp" alt="Electrical fittings">
                </div>

            </li>

            <!-- Curtains & Furnishings -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Curtains & Furnishings
                </h4>

                <p class="categories__item-info">
                    Drapery, soft furnishings & window treatments
                </p>

                <div class="categories__item-image">
                    <img src="/categories/curtains_&_furnishings_image_wdr.webp" alt="Curtains & Furnishings">
                </div>

            </li>

            <!-- Architectural trim -->
            <li class="categories__item">

                <h4 class="categories__item-title">
                    Architectural trim
                </h4>

                <p class="categories__item-info">
                    Shadow-gap profiles for ceilings and walls
                </p>

                <div class="categories__item-image">
                    <img src="/categories/architectural_trim_image_wdr.webp" alt="Architectural trim">
                </div>

            </li>

        </ul>

    </div>

</section>

<style>

    .categories {
        background-color: #F4F3F0;
        padding: 10rem 0;
        border-bottom: 0.05rem solid #888888;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .categories__header {
        margin-bottom: 6rem;
    }

    .categories__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .categories__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .categories__eyebrow span {
        color: var(--color-accent);
    }

    .categories__title {
        max-width: 75rem;
        color: #151516;
        font-size: clamp(3.8rem, 4.4vw, 4.2rem);
        margin-bottom: 4rem;
    }

    .categories__description {
        max-width: 80rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .categories__list {
        display: flex;
        gap: 2rem;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        cursor: grab;
        user-select: none;
    }

    .categories__list:active {
        cursor: grabbing;
    }

    .categories__list::-webkit-scrollbar {
        display: none;
    }

    .categories__item {
        flex: 0 0 30rem;
        height: 38rem;

        border: 0.05rem solid #888888;

        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

    .categories__item-title {
        color: #151516;
        padding: 3rem 3rem 0;
        margin-bottom: 1.4rem;
    }

    .categories__item-info {
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        padding: 0 3rem;
        margin: 0;
    }

    .categories__item-image {
        margin-top: auto;
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: flex-end;
        overflow: hidden;
    }

    .categories__item-image img {
        display: block;
        object-fit: contain;
        max-width: 100%;
        user-select: none;
        -webkit-user-drag: none;
        pointer-events: none;
    }

    @media (max-width: 768px) {

        .categories {
            padding: 6rem 0;
        }

        .categories__header {
            margin-bottom: 5rem;
            
        }

        .categories__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .categories__title {
            max-width: 100%;
            margin-bottom: 3rem;
            font-size: 3.2rem;
        }

        .categories__description {
            max-width: 100%;
            font-size: 1.4rem;
        }

        .categories__list {
            gap: 1.4rem;
            margin-right: -2rem;
            padding-right: 2rem;
        }

        .categories__item {
            flex: 0 0 24rem;
            height: 32rem;
        }

        .categories__item-title {
            padding: 2.4rem 2.4rem 0;
            margin-bottom: 1rem;
            font-size: 2.2rem;
        }

        .categories__item-info {
            padding: 0 2.4rem;
            font-size: 1.4rem;
            line-height: 1.;
        }

    }

</style>

<script>
    const slider = document.querySelector('.categories__list');

    if (slider instanceof HTMLElement) {

        let isDragging = false;
        let startX = 0;
        let startScrollLeft = 0;

        slider.addEventListener('pointerdown', (e) => {
            isDragging = true;

            startX = e.clientX;
            startScrollLeft = slider.scrollLeft;

            slider.setPointerCapture(e.pointerId);
        });

        slider.addEventListener('pointermove', (e) => {
            if (!isDragging) return;

            const walk = (e.clientX - startX) * 1.2;

            slider.scrollLeft = startScrollLeft - walk;
        });

        slider.addEventListener('pointerup', () => {
            isDragging = false;
        });

        slider.addEventListener('pointercancel', () => {
            isDragging = false;
        });

    }
</script>

