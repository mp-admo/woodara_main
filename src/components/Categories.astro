<style>

    .categories {
        background-color: #F4F3F0;
        padding: 10rem 0;
        border-bottom: 0.05rem solid #888888;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .categories__header {
        margin-bottom: 6rem;
    }

    .categories__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: 'TT Firs Neue', sans-serif;
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .categories__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .categories__eyebrow span {
        color: #2E7C77;
    }

    .categories__title {
        max-width: 75rem;
        color: #151516;
        font-size: clamp(3.8rem, 4.4vw, 4.2rem);
        margin-bottom: 4rem;
    }

    .categories__description {
        max-width: 80rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    .categories__list {
        display: flex;
        gap: 2rem;
        overflow-x: auto;
        overflow-y: hidden;
        scrollbar-width: none;
        cursor: grab;
        user-select: none;
    }

    .categories__list:active {
        cursor: grabbing;
    }

    .categories__list::-webkit-scrollbar {
        display: none;
    }

    .categories__item {
        flex: 0 0 28.2rem;
        height: 36rem;

        border: 0.05rem solid #888888;

        display: flex;
        flex-direction: column;
        cursor: pointer;
    }

    .categories__item-title {
        color: #151516;
        padding: 3rem 3rem 0;
    }

    .categories__item-image {
        flex: 1;
        min-height: 0;
    }

    .categories__item-image img {
        width: 100%;
        height: 100%;
        object-fit: contain;
        display: block;

        user-select: none;
        -webkit-user-drag: none;
        pointer-events: none;
    }

</style>

<script>
    const slider = document.querySelector('.categories__list');

    if (slider instanceof HTMLElement) {

        let isDragging = false;
        let startX = 0;
        let startScrollLeft = 0;

        slider.addEventListener('pointerdown', (e) => {
            isDragging = true;

            startX = e.clientX;
            startScrollLeft = slider.scrollLeft;

            slider.setPointerCapture(e.pointerId);
        });

        slider.addEventListener('pointermove', (e) => {
            if (!isDragging) return;

            const walk = (e.clientX - startX) * 1.2;

            slider.scrollLeft = startScrollLeft - walk;
        });

        slider.addEventListener('pointerup', () => {
            isDragging = false;
        });

        slider.addEventListener('pointercancel', () => {
            isDragging = false;
        });

    }
</script>

