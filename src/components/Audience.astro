---
import type { Language } from "../i18n";

const { lang = "en", t } = Astro.props as {
    lang: Language;
    t: (typeof import("../i18n").translations)["en"];
};
---


<section class="audience">

    <div class="container">

        <div class="audience__header">

            <div class="audience__eyebrow">
                <span>03</span>
                {t.builtForEyebrow}
            </div>

            <div class="audience__header-content">

                <h3 class="audience__title">
                    {t.builtForTitle}
                </h3>

                <p class="audience__description">
                    {t.builtForDescription}
                </p>

            </div>

        </div>

        <ul class="audience__list">

            <li class="audience__item">

                <span class="audience__item-label">
                    {t.builtForCard1Eyebrow}
                </span>

                <h4 class="audience__item-title">
                    {t.builtForCard1Title}
                </h4>

                <p class="audience__item-description">
                    {t.builtForCard1Description}
                </p>

            </li>

            <li class="audience__item">

                <span class="audience__item-label">
                    {t.builtForCard2Eyebrow}
                </span>

                <h4 class="audience__item-title">
                    {t.builtForCard2Title}
                </h4>

                <p class="audience__item-description">
                    {t.builtForCard2Description}
                </p>

            </li>

            <li class="audience__item">

                <span class="audience__item-label">
                    {t.builtForCard3Eyebrow}
                </span>

                <h4 class="audience__item-title">
                    {t.builtForCard3Title}
                </h4>

                <p class="audience__item-description">
                    {t.builtForCard3Description}
                </p>

            </li>

        </ul>

    </div>

</section>

<style>

    .audience {
        background-color: #F4F3F0;
        padding: 10rem 0;
        border-top: 0.05rem solid #888888;
        border-bottom: 0.05rem solid #888888;
    }

    .container {
        width: 100%;
        max-width: 140rem;
        padding: 0 2rem;
        margin: 0 auto;
    }

    .audience__header {
        margin-bottom: 6rem;
    }

    .audience__eyebrow {
        display: flex;
        align-items: center;
        gap: 1rem;
        font-family: var(--font-display);
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03rem;
        text-transform: uppercase;
        margin-bottom: 6rem;
    }

    .audience__eyebrow::before {
        content: "";
        width: 2rem;
        height: 0.1rem;
        background-color: #888888;
        flex-shrink: 0;
    }

    .audience__eyebrow span {
        color: var(--color-accent);
    }

    .audience__header-content {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 6rem;
        align-items: end;
    }

    .audience__title {
        max-width: 60rem;
        color: #151516;
        font-size: clamp(3.8rem, 4.4vw, 4.2rem);
        margin: 0;
    }

    .audience__description {
        max-width: 60rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
        margin-bottom: 0.6rem;
    }

    .audience__list {
        position: relative;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .audience__list::before,
    .audience__list::after {
        content: "";
        position: absolute;
        left: 50%;
        width: 100vw;
        height: 0.05rem;
        background-color: #888888;
        transform: translateX(-50%);
        pointer-events: none;
    }

    .audience__list::before {
        top: 0;
    }

    .audience__list::after {
        bottom: 0;
    }

    .audience__item {
        padding: 4rem;
        border-right: 0.05rem solid #888888;
        display: flex;
        flex-direction: column;
    }

    .audience__item:first-child {
        padding-left: 0;
    }

    .audience__item:last-child {
        border-right: none;
    }

    .audience__item-label {
        font-family: var(--font-display);
        color: #58585A;
        font-size: 1.6rem;
        letter-spacing: -0.03em;
        text-transform: uppercase;
        margin-bottom: 5rem;
    }

    .audience__item-title {
        max-width: 36rem;
        color: #151516;
        margin-bottom: 4rem;
    }

    .audience__item-description {
        max-width: 48rem;
        color: #58585A;
        font-size: 1.6rem;
        line-height: 1.4;
    }

    @media (max-width: 768px) {

        .audience {
            padding: 6rem 0;
        }

        .audience__header {
            margin-bottom: 5rem;
        }

        .audience__eyebrow {
            margin-bottom: 4rem;
            font-size: 1.3rem;
        }

        .audience__header-content {
            display: flex;
            flex-direction: column;
            gap: 0;
            align-items: stretch;
        }

        .audience__title {
            max-width: 100%;
            font-size: 3.2rem;
            margin-bottom: 3rem;
        }

        .audience__description {
            max-width: 100%;
            font-size: 1.4rem;
            margin: 0;
        }

        .audience__list {
            grid-template-columns: 1fr;
            gap: 1.4rem;
        }

        .audience__list::before,
        .audience__list::after {
            display: none;
        }

        .audience__item,
        .audience__item:first-child,
        .audience__item:last-child {
            padding: 3rem 2.4rem;
            border: 0.05rem solid #888888;
        }

        .audience__item-label {
            font-size: 1.3rem;
            margin-bottom: 3rem;
            
        }

        .audience__item-title {
            max-width: 100%;
            margin-bottom: 2rem;
            font-size: 2.2rem;
            max-width: 32rem;
        }

        .audience__item-description {
            max-width: 100%;
            font-size: 1.4rem;
        }

    }

</style>