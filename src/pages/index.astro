---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Showcase from "../components/Showcase.astro";
import Categories from "../components/Categories.astro";
import HeroShowcaseDecorations from "../components/decorations/HeroShowcaseDecorations.astro";
import Projects from "../components/Projects.astro";
import Audience from "../components/Audience.astro";
import Scope from "../components/Scope.astro";
import AudienceScopeDecorations from "../components/decorations/AudienceScopeDecorations.astro";
import Comparison from "../components/Comparison.astro";
import Volume from "../components/Volume.astro";
import Honest from "../components/Honest.astro";
import Optimization from "../components/Optimization.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Contact from "../components/Contact.astro";
---

<Layout>

    <div class="hero-showcase">

        <Hero />
        <Showcase />
        <Categories />
        <HeroShowcaseDecorations />

    </div>

    <Projects />

    <div class="audience-scope">

        <Audience />
        <Scope />
        <AudienceScopeDecorations />

    </div>

    <Comparison />

    <Volume />

    <Honest />

    <Optimization />
    
    <Process />

    <Faq />

    <Contact />
	
</Layout>

<style>

    .hero-showcase {
        position: relative;
        overflow: hidden;
    }

    .audience-scope {
        position: relative;
    }

</style>