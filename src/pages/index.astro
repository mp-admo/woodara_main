---
import { languageCodes } from "../i18n";

// The site lives under /en/, /id/ and /ru/. The root only forwards to the right one:
// the first supported language of the browser, English otherwise.
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Woodara</title>
        <meta name="robots" content="noindex" />
        <link rel="canonical" href="/en/" />
        <meta http-equiv="refresh" content="0;url=/en/" />

        <script is:inline define:vars={{ supported: languageCodes }}>
            var languages = navigator.languages || [navigator.language || ""];
            var target = "/en/";

            for (var i = 0; i < languages.length; i++) {
                var code = String(languages[i]).toLowerCase().slice(0, 2);

                if (supported.indexOf(code) !== -1) {
                    target = "/" + code + "/";
                    break;
                }
            }

            window.location.replace(target + window.location.search + window.location.hash);
        </script>
    </head>

    <body>
        <a href="/en/">Woodara</a>
    </body>
</html>
